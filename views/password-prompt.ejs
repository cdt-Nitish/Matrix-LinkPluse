<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Password Required — LinkPulse</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>

<%- include('partials/nav', { page: '' }) %>

<main class="main-content">
  <div class="container container-xs">
    <div class="center-card">
      <div class="icon-lg">🔐</div>
      <h1 class="page-title">Password Required</h1>
      <p class="page-sub">This link is protected. Enter the password to continue.</p>

      <% if (error) { %>
      <div class="alert alert-error">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="flex-shrink:0;margin-top:2px"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span><%= error %></span>
      </div>
      <% } %>

      <div class="card" style="text-align:left">
        <form method="POST" action="/<%= shortCode %>/unlock">
          <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" class="input" autofocus required>
          </div>
          <button type="submit" class="btn btn-primary" style="width:100%">Unlock →</button>
        </form>
      </div>

      <p style="margin-top:1.25rem; font-size:0.8125rem; color:var(--text-3)">
        <a href="/" style="color:var(--text-2)">← Back to LinkPulse</a>
      </p>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
</body>
</html>

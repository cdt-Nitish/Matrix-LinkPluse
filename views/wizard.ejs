<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>New Link — LinkPulse</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>

<%- include('partials/nav', { page: 'dashboard' }) %>

<main class="main-content">
  <div class="container container-sm">

    <div class="page-header">
      <div>
        <h1 class="page-title">Create New Link</h1>
        <p class="page-sub">
          <% if (step === 1) { %>Step 1 of 2 — Target destination &amp; alias<% } else { %>Step 2 of 2 — Routing rules &amp; protection<% } %>
        </p>
      </div>
    </div>

    <!-- Steps -->
    <div class="steps">
      <div class="step <%= step >= 1 ? 'done' : '' %>">
        <div class="step-num">1</div>
        <span>Destination</span>
      </div>
      <div class="step-line"></div>
      <div class="step <%= step >= 2 ? 'done' : '' %>">
        <div class="step-num">2</div>
        <span>Rules</span>
      </div>
    </div>

    <% if (error) { %>
    <div class="alert alert-error">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <span><%= error %></span>
    </div>
    <% } %>

    <div class="card">
      <% if (step === 1) { %>

      <form method="POST" action="/links/step1">
        <div class="form-group">
          <label for="originalUrl">Destination URL <span class="required">*</span></label>
          <input type="url" id="originalUrl" name="originalUrl" class="input"
            placeholder="https://example.com/long-page-url"
            value="<%= formData.originalUrl || '' %>" required autofocus />
        </div>

        <div class="form-group">
          <label for="customAlias">Custom alias <span class="hint">— leave blank for auto-generated</span></label>
          <div class="input-prefix-wrap">
            <span class="input-prefix">linkpulse.io/</span>
            <input type="text" id="customAlias" name="customAlias" class="input input-prefixed"
              placeholder="my-alias"
              value="<%= formData.customAlias || '' %>"
              pattern="[a-zA-Z0-9\-_]+"
              title="Letters, numbers, hyphens and underscores only" />
          </div>
        </div>

        <div class="form-group">
          <label for="title">Title <span class="hint">— optional label for dashboard</span></label>
          <input type="text" id="title" name="title" class="input"
            placeholder="e.g. Q4 Landing Page"
            value="<%= formData.title || '' %>" />
        </div>

        <div class="form-actions">
          <a href="/" class="btn btn-ghost">Cancel</a>
          <button type="submit" class="btn btn-primary">Continue &rarr;</button>
        </div>
      </form>

      <% } else { %>

      <form method="POST" action="/links/publish">
        <input type="hidden" name="originalUrl" value="<%= formData.originalUrl %>">
        <input type="hidden" name="customAlias" value="<%= formData.customAlias || '' %>">
        <input type="hidden" name="title" value="<%= formData.title || '' %>">

        <div class="form-grid">
          <div class="form-group">
            <label for="campaignId">Campaign <span class="hint">— optional</span></label>
            <select id="campaignId" name="campaignId" class="input">
              <option value="">No campaign</option>
              <% campaigns.forEach(c => { %>
              <option value="<%= c.id %>"><%= c.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label for="tags">Tags <span class="hint">— comma-separated</span></label>
            <input type="text" id="tags" name="tags" class="input" placeholder="launch, promo, docs">
          </div>
          <div class="form-group">
            <label for="expiresAt">Expiration date <span class="hint">— optional</span></label>
            <input type="datetime-local" id="expiresAt" name="expiresAt" class="input">
          </div>
          <div class="form-group">
            <label for="maxClicks">Click limit <span class="hint">— optional</span></label>
            <input type="number" id="maxClicks" name="maxClicks" class="input" placeholder="e.g. 1000" min="1">
          </div>
          <div class="form-group">
            <label for="password">Password <span class="hint">— leave blank for public access</span></label>
            <input type="password" id="password" name="password" class="input" placeholder="Access password">
          </div>
          <div class="form-group">
            <label for="mobileUrl">Mobile URL <span class="hint">— optional device override</span></label>
            <input type="url" id="mobileUrl" name="mobileUrl" class="input" placeholder="https://m.example.com/">
          </div>
        </div>

        <div class="form-actions">
          <a href="/links/new" class="btn btn-ghost">&larr; Back</a>
          <button type="submit" class="btn btn-primary">Publish Link</button>
        </div>
      </form>

      <% } %>
    </div>

  </div>
</main>

<%- include('partials/footer') %>
</body>
</html>

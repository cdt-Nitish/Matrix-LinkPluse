<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <%
    const titles = { '404': 'Not Found', expired: 'Link Expired', limit: 'Limit Reached', disabled: 'Link Disabled' };
  %>
  <title><%= titles[type] || 'Error' %> — LinkPulse</title>
  <meta name="description" content="LinkPulse URL status and notice.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
  <%- include('partials/theme-head') %>
</head>
<body class="auth-page">

  <!-- Minimal Brand Header with Theme Toggle -->
  <%- include('partials/auth-header') %>

  <main class="auth-main-wrapper">
    <div class="auth-card" style="max-width: 480px; text-align: center;">
      <%
        const icons = { '404': '🔍', expired: '⏳', limit: '🛑', disabled: '🚫' };
      %>
      <div style="font-size: 2.75rem; margin-bottom: 1rem;" aria-hidden="true"><%= icons[type] || '⚠️' %></div>
      <h1 class="auth-title" style="margin-bottom: 8px;"><%= titles[type] || 'Something went wrong' %></h1>
      <p class="auth-desc" style="margin-bottom: 24px;"><%= message %></p>
      
      <a href="/" class="btn-auth-submit" style="text-decoration: none; width: 100%;">
        &larr; Return to Dashboard
      </a>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>

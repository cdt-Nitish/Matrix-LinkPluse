<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= typeof title !== 'undefined' ? title : (typeof pageTitle !== 'undefined' ? pageTitle : 'Sign In') %> — LinkPulse</title>
  <meta name="description" content="Sign in to your LinkPulse URL governance and analytics workspace.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
  <%- include('partials/theme-head') %>
</head>
<body class="auth-page">

  <!-- Header and Navigation (68px, 1120px max-width, logo on left, theme & back to home on right) -->
  <%- include('partials/auth-header') %>

  <!-- Main Centered Authentication Area -->
  <main class="auth-main-wrapper" id="mainContent">
    <div class="auth-card" id="authCard">

      <!-- 1. Sign In and Create Account Tabs -->
      <nav class="auth-tabs" aria-label="Authentication navigation">
        <a href="/login" class="auth-tab active" id="tabSignIn" aria-current="page">Sign In</a>
        <a href="/signup" class="auth-tab" id="tabSignUp">Create Account</a>
      </nav>

      <!-- 2. Small Blue Document Icon -->
      <div class="auth-icon-wrap" aria-hidden="true">
        <div class="auth-doc-icon-box">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <line x1="10" y1="9" x2="8" y2="9"></line>
          </svg>
        </div>
      </div>

      <!-- 3. Welcome Heading and Supporting Text -->
      <header class="auth-header-text">
        <h1 class="auth-title">Welcome Back</h1>
        <p class="auth-desc">Enter your credentials to access your dashboard.</p>
      </header>

      <!-- 4. Demo Credential Panel -->
      <section class="demo-credential-panel" aria-label="Demo Credentials">
        <!-- Row 1: Admin -->
        <div class="demo-credential-row">
          <div class="demo-credential-info">
            <span class="demo-credential-role">Admin:</span>
            <code>admin@linkpulse.io</code>
          </div>
          <button 
            type="button" 
            class="btn-demo-primary" 
            id="fillAdminBtn"
            onclick="fillDemoCredentials('admin@linkpulse.io', 'password123')"
            aria-label="Autofill Administrator demo credentials"
          >
            Fill Admin
          </button>
        </div>

        <!-- Row 2: User -->
        <div class="demo-credential-row">
          <div class="demo-credential-info">
            <span class="demo-credential-role" style="color:var(--text-secondary);">User:</span>
            <code>demo@linkpulse.io</code>
          </div>
          <button 
            type="button" 
            class="btn-demo-outline" 
            id="fillUserBtn"
            onclick="fillDemoCredentials('demo@linkpulse.io', 'password123')"
            aria-label="Autofill standard User demo credentials"
          >
            Fill User
          </button>
        </div>
      </section>

      <!-- Specific Feedback Alerts -->
      <% 
        const errList = (typeof errors !== 'undefined' && Array.isArray(errors) && errors.length > 0) 
          ? errors 
          : (typeof error !== 'undefined' && error ? [error] : []); 
      %>

      <% if (errList.length > 0) { %>
      <div class="auth-alert auth-alert-error" role="alert" id="authErrorAlert">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0;margin-top:1px;">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <div class="auth-alert-message">
          <% errList.forEach(function(msg) { %>
            <div class="error-msg-item"><%= msg %></div>
          <% }); %>
        </div>
      </div>
      <% } %>

      <% if (typeof success !== 'undefined' && success) { %>
      <div class="auth-alert auth-alert-success" role="alert" id="authSuccessAlert">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0;margin-top:1px;">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
          <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
        <div class="auth-alert-message"><%= success %></div>
      </div>
      <% } %>

      <!-- Authentication Form -->
      <form method="POST" action="/login" class="auth-form" id="loginForm" novalidate>
        <input type="hidden" name="redirectUrl" value="<%= typeof redirectUrl !== 'undefined' ? redirectUrl : '/' %>">

        <% 
          let filledEmail = '';
          if (typeof oldInput !== 'undefined' && oldInput) {
            filledEmail = oldInput.email || oldInput.loginId || '';
          } else if (typeof loginId !== 'undefined' && loginId) {
            filledEmail = loginId;
          }
        %>

        <!-- 5. Email or Username Field -->
        <div class="form-field-group">
          <label for="email" class="form-field-label">Email or username</label>
          <input 
            type="text" 
            id="email" 
            name="email" 
            class="form-field-input" 
            placeholder="admin@linkpulse.io or username" 
            value="<%= filledEmail %>" 
            required 
            autofocus 
            autocomplete="username"
          />
        </div>

        <!-- 6. Password Field with Show/Hide Functionality -->
        <div class="form-field-group">
          <label for="password" class="form-field-label">Password</label>
          <div class="password-input-wrap">
            <input 
              type="password" 
              id="password" 
              name="password" 
              class="form-field-input" 
              placeholder="Enter your account password" 
              value="<%= typeof demoPassword !== 'undefined' ? demoPassword : '' %>"
              required 
              autocomplete="current-password"
            />
            <button 
              type="button" 
              class="password-toggle-btn" 
              id="passwordToggleBtn"
              aria-label="Show password" 
              title="Show password"
              onclick="togglePasswordVisibility('password', this)"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="eye-icon" aria-hidden="true">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </button>
          </div>
        </div>

        <!-- 7. Remember Me Checkbox -->
        <div class="auth-remember-row">
          <input 
            type="checkbox" 
            id="rememberMe" 
            name="remember" 
            value="on" 
            class="auth-checkbox"
            checked 
          />
          <label for="rememberMe" class="auth-checkbox-label">Remember me for 30 days</label>
        </div>

        <!-- 8. Full-Width Sign In Button -->
        <button 
          type="submit" 
          class="btn-auth-submit" 
          id="submitLoginBtn"
        >
          <span class="btn-text">Sign In</span>
        </button>
      </form>

      <!-- 9. Create Account Link -->
      <p class="auth-footer-prompt">
        <span>Don't have an account?</span>
        <a href="/signup" class="auth-footer-link" id="createAccountLink">Create an account</a>
      </p>

    </div>
  </main>

  <%- include('partials/footer') %>

  <!-- Interactive Client-side Script -->
  <script>
    function fillDemoCredentials(email, password) {
      var emailInput = document.getElementById('email');
      var passInput = document.getElementById('password');
      if (emailInput) {
        emailInput.value = email;
        emailInput.focus();
      }
      if (passInput) {
        passInput.value = password;
      }
      // Clear visible error message when switching credentials
      var alertBox = document.getElementById('authErrorAlert');
      if (alertBox) {
        alertBox.style.display = 'none';
      }
    }

    function togglePasswordVisibility(inputId, btn) {
      var input = document.getElementById(inputId);
      if (!input) return;
      var isPassword = input.type === 'password';
      input.type = isPassword ? 'text' : 'password';

      var eyeSvg = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>';
      var eyeOffSvg = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>';

      btn.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
      btn.setAttribute('title', isPassword ? 'Hide password' : 'Show password');
      btn.innerHTML = isPassword ? eyeOffSvg : eyeSvg;
      input.focus();
    }

    // Form duplicate submission prevention & loading state
    (function() {
      var form = document.getElementById('loginForm');
      var btn = document.getElementById('submitLoginBtn');
      if (!form || !btn) return;

      var isSubmitting = false;

      form.addEventListener('submit', function(e) {
        if (isSubmitting) {
          e.preventDefault();
          return false;
        }

        var email = document.getElementById('email');
        var password = document.getElementById('password');

        if (!email.value.trim()) {
          e.preventDefault();
          email.focus();
          return false;
        }

        if (!password.value) {
          e.preventDefault();
          password.focus();
          return false;
        }

        isSubmitting = true;
        btn.disabled = true;
        btn.innerHTML = '<span class="btn-spinner" aria-hidden="true"></span><span>Signing In...</span>';
      });
    })();
  </script>
</body>
</html>

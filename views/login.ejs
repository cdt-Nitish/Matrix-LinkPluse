<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= typeof title !== 'undefined' ? title : (typeof pageTitle !== 'undefined' ? pageTitle : 'Sign In') %> — LinkPulse</title>
  <meta name="description" content="Sign in to your LinkPulse workspace.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body class="auth-page">

  <!-- Compact Top Header for Auth Pages -->
  <header class="landing-nav-container">
    <div class="container">
      <nav class="landing-navbar">
        <a href="/" class="landing-brand">
          <div class="sidebar-logo-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="13 2 13 9 20 9"/>
              <path d="M20 9L13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/>
            </svg>
          </div>
          <span>LinkPulse</span>
        </a>
        <div>
          <a href="/" class="btn btn-ghost btn-sm">&larr; Back to Home</a>
        </div>
      </nav>
    </div>
  </header>

<main class="main-content">
  <div class="container container-xs auth-page-container">
    <div class="auth-box">

      <!-- Switcher Tabs -->
      <div class="auth-tabs">
        <a href="/login" class="auth-tab active" id="tabSignIn">Sign In</a>
        <a href="/signup" class="auth-tab" id="tabSignUp">Create Account</a>
      </div>

      <div class="auth-box-header">
        <div class="auth-badge-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="13 2 13 9 20 9"/><path d="M20 9L13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/>
          </svg>
        </div>
        <h1 class="auth-headline">Welcome Back</h1>
        <p class="auth-subline">Enter your credentials to access your dashboard.</p>
      </div>

      <!-- Quick Demo Credentials for Fast Evaluation -->
      <div class="auth-demo-banner" style="display:flex;flex-direction:column;gap:8px;">
        <div style="display:flex;align-items:center;justify-content:space-between;width:100%;">
          <span><strong style="color:var(--primary);">Admin:</strong> <code>admin@linkpulse.io</code></span>
          <button type="button" class="btn btn-sm btn-primary" onclick="document.getElementById('email').value='admin@linkpulse.io';document.getElementById('password').value='password123';" id="fillAdminBtn">
            Fill Admin
          </button>
        </div>
        <div style="display:flex;align-items:center;justify-content:space-between;width:100%;border-top:1px solid var(--border);padding-top:6px;">
          <span><strong style="color:var(--text-secondary);">User:</strong> <code>demo@linkpulse.io</code></span>
          <button type="button" class="btn btn-sm btn-ghost" onclick="document.getElementById('email').value='demo@linkpulse.io';document.getElementById('password').value='password123';" id="fillUserBtn">
            Fill User
          </button>
        </div>
      </div>

      <!-- Specific Error Display -->
      <% 
        const errList = (typeof errors !== 'undefined' && Array.isArray(errors) && errors.length > 0) 
          ? errors 
          : (typeof error !== 'undefined' && error ? [error] : []); 
      %>

      <% if (errList.length > 0) { %>
      <div class="alert alert-error" role="alert" id="authErrorAlert">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <div class="alert-content">
          <% errList.forEach(function(msg) { %>
            <div class="error-msg-item">
              <% if (msg.toLowerCase().includes('email') || msg.toLowerCase().includes('account') || msg.toLowerCase().includes('username')) { %>
                <strong>Email Error:</strong> <%= msg %>
              <% } else if (msg.toLowerCase().includes('password')) { %>
                <strong>Password Error:</strong> <%= msg %>
              <% } else { %>
                <%= msg %>
              <% } %>
            </div>
          <% }); %>
        </div>
      </div>
      <% } %>

      <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success" role="alert">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <span><%= success %></span>
      </div>
      <% } %>

      <!-- Form Submission -->
      <form method="POST" action="/login" class="auth-form" id="loginForm">
        <input type="hidden" name="redirectUrl" value="<%= typeof redirectUrl !== 'undefined' ? redirectUrl : '/' %>">

        <% 
          let filledEmail = '';
          if (typeof oldInput !== 'undefined' && oldInput) {
            filledEmail = oldInput.email || oldInput.loginId || '';
          } else if (typeof loginId !== 'undefined' && loginId) {
            filledEmail = loginId;
          }
        %>

        <div class="form-group">
          <label for="email">Email or username <span class="required">*</span></label>
          <input 
            type="text" 
            id="email" 
            name="email" 
            class="input" 
            placeholder="admin@linkpulse.io" 
            value="<%= filledEmail %>" 
            required 
            autofocus 
          />
        </div>

        <div class="form-group">
          <label for="password">Password <span class="required">*</span></label>
          <input 
            type="password" 
            id="password" 
            name="password" 
            class="input" 
            placeholder="Enter your account password" 
            value="<%= typeof demoPassword !== 'undefined' ? demoPassword : '' %>"
            required 
          />
        </div>

        <div class="form-group" style="margin-bottom:1.25rem;">
          <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;font-weight:400;color:var(--text-secondary);font-size:0.84rem;">
            <input type="checkbox" name="remember" value="on" checked style="accent-color:var(--primary);">
            <span>Remember me for 30 days</span>
          </label>
        </div>

        <button type="submit" class="btn btn-primary" style="width:100%;min-height:42px;font-size:0.95rem;" id="submitLoginBtn">
          Sign In
        </button>
      </form>

      <div style="text-align:center;margin-top:1.5rem;font-size:0.85rem;color:var(--text-secondary);">
        <span>Don't have an account?</span>
        <a href="/signup" style="font-weight:600;color:var(--primary);margin-left:4px;">Create an account &rarr;</a>
      </div>

    </div>
  </div>
</main>

<%- include('partials/footer') %>

</body>
</html>

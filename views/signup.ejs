<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= typeof title !== 'undefined' ? title : (typeof pageTitle !== 'undefined' ? pageTitle : 'Create Account') %> — LinkPulse</title>
  <meta name="description" content="Create a new LinkPulse developer account.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
  <%- include('partials/theme-head') %>
</head>
<body class="auth-page">

  <!-- Header and Navigation -->
  <%- include('partials/auth-header') %>

  <!-- Main Centered Authentication Area -->
  <main class="auth-main-wrapper" id="mainContent">
    <div class="auth-card" id="authCard">

      <!-- 1. Tabs -->
      <nav class="auth-tabs" aria-label="Authentication navigation">
        <a href="/login" class="auth-tab" id="tabSignIn">Sign In</a>
        <a href="/signup" class="auth-tab active" id="tabSignUp" aria-current="page">Create Account</a>
      </nav>

      <!-- 2. Blue User Icon -->
      <div class="auth-icon-wrap" aria-hidden="true">
        <div class="auth-doc-icon-box">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="8.5" cy="7" r="4"></circle>
            <line x1="20" y1="8" x2="20" y2="14"></line>
            <line x1="23" y1="11" x2="17" y2="11"></line>
          </svg>
        </div>
      </div>

      <!-- 3. Heading and Subtitle -->
      <header class="auth-header-text">
        <h1 class="auth-title">Create Account</h1>
        <p class="auth-desc">Join LinkPulse with a secure developer account.</p>
      </header>

      <!-- Validation Errors Display -->
      <% 
        const errList = (typeof errors !== 'undefined' && Array.isArray(errors) && errors.length > 0) 
          ? errors 
          : (typeof error !== 'undefined' && error ? [error] : []); 
      %>

      <% if (errList.length > 0) { %>
      <div class="auth-alert auth-alert-error" role="alert" id="signupErrorAlert">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0;margin-top:1px;">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <div class="auth-alert-message">
          <div style="font-weight:600;margin-bottom:4px;">Please resolve the following:</div>
          <ul style="padding-left:1.15rem;margin:0;font-size:13px;">
            <% errList.forEach(function(msg) { %>
              <li><%= msg %></li>
            <% }); %>
          </ul>
        </div>
      </div>
      <% } %>

      <!-- Registration Form -->
      <form method="POST" action="/signup" class="auth-form" id="signupForm" novalidate>
        <% 
          const currentInput = (typeof oldInput !== 'undefined' && oldInput) 
            ? oldInput 
            : ((typeof formData !== 'undefined' && formData) ? formData : {});
        %>

        <!-- First & Last Name (2 columns) -->
        <div class="auth-row-2col">
          <div class="form-field-group">
            <label for="firstName" class="form-field-label">First name <span class="required">*</span></label>
            <input 
              type="text" 
              id="firstName" 
              name="firstName" 
              class="form-field-input" 
              placeholder="First name" 
              value="<%= currentInput.firstName || (currentInput.fullName ? currentInput.fullName.split(' ')[0] : '') %>" 
              required 
              autofocus 
              autocomplete="given-name"
            />
          </div>

          <div class="form-field-group">
            <label for="lastName" class="form-field-label">Last name <span class="hint">— optional</span></label>
            <input 
              type="text" 
              id="lastName" 
              name="lastName" 
              class="form-field-input" 
              placeholder="Last name" 
              value="<%= currentInput.lastName || (currentInput.fullName ? currentInput.fullName.split(' ').slice(1).join(' ') : '') %>" 
              autocomplete="family-name"
            />
          </div>
        </div>

        <input type="hidden" id="fullName" name="fullName" value="<%= currentInput.fullName || '' %>" />

        <!-- Email Address -->
        <div class="form-field-group">
          <label for="email" class="form-field-label">Email address <span class="required">*</span></label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            class="form-field-input" 
            placeholder="name@company.com" 
            value="<%= currentInput.email || '' %>" 
            required 
            autocomplete="email"
          />
        </div>

        <!-- Account Role Selection -->
        <div class="form-field-group">
          <label for="userType" class="form-field-label">Account Role <span class="required">*</span></label>
          <select id="userType" name="userType" class="form-field-input">
            <option value="user" <%= (!currentInput.userType || currentInput.userType === 'user' || currentInput.role === 'user') ? 'selected' : '' %>>Authorised User — Personal links and telemetry</option>
            <option value="admin" <%= (currentInput.userType === 'admin' || currentInput.role === 'admin') ? 'selected' : '' %>>Administrator — Full platform governance &amp; security</option>
            <option value="host" <%= (currentInput.userType === 'host' || currentInput.role === 'host') ? 'selected' : '' %>>Host — Team workspaces &amp; campaigns</option>
          </select>
        </div>

        <!-- Password Inputs (2 columns, both with visibility toggle) -->
        <div class="auth-row-2col">
          <div class="form-field-group">
            <label for="password" class="form-field-label">Password <span class="required">*</span></label>
            <div class="password-input-wrap">
              <input 
                type="password" 
                id="password" 
                name="password" 
                class="form-field-input" 
                placeholder="Strong password" 
                required 
                autocomplete="new-password"
              />
              <button 
                type="button" 
                class="password-toggle-btn" 
                id="pwdToggleBtn1"
                aria-label="Show password" 
                title="Show password"
                onclick="togglePasswordVisibility('password', this)"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
              </button>
            </div>
          </div>

          <div class="form-field-group">
            <label for="confirmPassword" class="form-field-label">Confirm password <span class="required">*</span></label>
            <div class="password-input-wrap">
              <input 
                type="password" 
                id="confirmPassword" 
                name="confirmPassword" 
                class="form-field-input" 
                placeholder="Confirm password" 
                required 
                autocomplete="new-password"
              />
              <button 
                type="button" 
                class="password-toggle-btn" 
                id="pwdToggleBtn2"
                aria-label="Show password" 
                title="Show password"
                onclick="togglePasswordVisibility('confirmPassword', this)"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
              </button>
            </div>
          </div>
        </div>

        <!-- Password Requirements Grid -->
        <div class="pwd-rules-container" id="pwdRulesBox">
          <div class="pwd-rules-heading">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <span>Password Requirements:</span>
          </div>

          <div class="pwd-rules-grid">
            <div class="pwd-rule-item" id="req-len">
              <span class="pwd-rule-dot">●</span>
              <span>At least <strong>6 chars</strong></span>
            </div>
            <div class="pwd-rule-item" id="req-upper">
              <span class="pwd-rule-dot">●</span>
              <span>One <strong>uppercase</strong> (A-Z)</span>
            </div>
            <div class="pwd-rule-item" id="req-lower">
              <span class="pwd-rule-dot">●</span>
              <span>One <strong>lowercase</strong> (a-z)</span>
            </div>
            <div class="pwd-rule-item" id="req-num">
              <span class="pwd-rule-dot">●</span>
              <span>One <strong>number</strong> (0-9)</span>
            </div>
            <div class="pwd-rule-item" id="req-spec">
              <span class="pwd-rule-dot">●</span>
              <span>Special char (!@#$%)</span>
            </div>
            <div class="pwd-rule-item" id="req-match">
              <span class="pwd-rule-dot">●</span>
              <span>Passwords <strong>match</strong></span>
            </div>
          </div>
        </div>

        <!-- Terms of Service Checkbox -->
        <div class="auth-remember-row" style="margin-top:16px;margin-bottom:20px;">
          <input 
            type="checkbox" 
            name="terms" 
            id="terms" 
            value="on" 
            class="auth-checkbox"
            checked 
            required
          />
          <label for="terms" class="auth-checkbox-label">
            I agree to the Terms of Service &amp; Privacy Policy
          </label>
        </div>

        <!-- Full-Width Create Account Button -->
        <button 
          type="submit" 
          class="btn-auth-submit" 
          id="submitSignupBtn"
        >
          <span class="btn-text">Create Account</span>
        </button>
      </form>

      <!-- Sign In Link -->
      <p class="auth-footer-prompt">
        <span>Already have an account?</span>
        <a href="/login" class="auth-footer-link" id="signInLink">Sign in</a>
      </p>

    </div>
  </main>

  <%- include('partials/footer') %>

  <!-- Interactive Scripts -->
  <script>
    function togglePasswordVisibility(inputId, btn) {
      var input = document.getElementById(inputId);
      if (!input) return;
      var isPassword = input.type === 'password';
      input.type = isPassword ? 'text' : 'password';

      var eyeSvg = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>';
      var eyeOffSvg = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>';

      btn.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
      btn.setAttribute('title', isPassword ? 'Hide password' : 'Show password');
      btn.innerHTML = isPassword ? eyeOffSvg : eyeSvg;
      input.focus();
    }

    (function() {
      var pwdInput = document.getElementById('password');
      var confirmInput = document.getElementById('confirmPassword');
      var firstName = document.getElementById('firstName');
      var lastName = document.getElementById('lastName');
      var fullName = document.getElementById('fullName');

      function syncFullName() {
        if (fullName) {
          fullName.value = ((firstName ? firstName.value : '') + ' ' + (lastName ? lastName.value : '')).trim();
        }
      }

      if (firstName) firstName.addEventListener('input', syncFullName);
      if (lastName) lastName.addEventListener('input', syncFullName);

      var rules = {
        len: document.getElementById('req-len'),
        upper: document.getElementById('req-upper'),
        lower: document.getElementById('req-lower'),
        num: document.getElementById('req-num'),
        spec: document.getElementById('req-spec'),
        match: document.getElementById('req-match')
      };

      function updateRule(element, isValid) {
        if (!element) return;
        if (isValid) {
          element.classList.add('valid');
        } else {
          element.classList.remove('valid');
        }
      }

      function checkPassword() {
        var val = pwdInput ? pwdInput.value : '';
        var confirmVal = confirmInput ? confirmInput.value : '';

        updateRule(rules.len, val.length >= 6);
        updateRule(rules.upper, /[A-Z]/.test(val));
        updateRule(rules.lower, /[a-z]/.test(val));
        updateRule(rules.num, /[0-9]/.test(val));
        updateRule(rules.spec, /[\W_]/.test(val));
        updateRule(rules.match, val.length > 0 && val === confirmVal);
      }

      if (pwdInput) pwdInput.addEventListener('input', checkPassword);
      if (confirmInput) confirmInput.addEventListener('input', checkPassword);
      checkPassword();

      // Form submit handler with loading state and duplicate submission prevention
      var form = document.getElementById('signupForm');
      var btn = document.getElementById('submitSignupBtn');
      if (form && btn) {
        var isSubmitting = false;
        form.addEventListener('submit', function(e) {
          if (isSubmitting) {
            e.preventDefault();
            return false;
          }
          isSubmitting = true;
          btn.disabled = true;
          btn.innerHTML = '<span class="btn-spinner" aria-hidden="true"></span><span>Creating Account...</span>';
        });
      }
    })();
  </script>
</body>
</html>

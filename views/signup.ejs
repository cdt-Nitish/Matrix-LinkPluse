<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= typeof title !== 'undefined' ? title : (typeof pageTitle !== 'undefined' ? pageTitle : 'Create Account') %> — LinkPulse</title>
  <meta name="description" content="Create a new LinkPulse workspace account.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body class="auth-page">

  <!-- Compact Top Header for Auth Pages -->
  <header class="landing-nav-container">
    <div class="container">
      <nav class="landing-navbar">
        <a href="/" class="landing-brand">
          <div class="sidebar-logo-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="13 2 13 9 20 9"/>
              <path d="M20 9L13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/>
            </svg>
          </div>
          <span>LinkPulse</span>
        </a>
        <div>
          <a href="/" class="btn btn-ghost btn-sm">&larr; Back to Home</a>
        </div>
      </nav>
    </div>
  </header>

<main class="main-content">
  <div class="container container-xs auth-page-container">
    <div class="auth-box">

      <!-- Switcher Tabs -->
      <div class="auth-tabs">
        <a href="/login" class="auth-tab" id="tabSignIn">Sign In</a>
        <a href="/signup" class="auth-tab active" id="tabSignUp">Create Account</a>
      </div>

      <div class="auth-box-header">
        <div class="auth-badge-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="8.5" cy="7" r="4"/>
            <line x1="20" y1="8" x2="20" y2="14"/>
            <line x1="23" y1="11" x2="17" y2="11"/>
          </svg>
        </div>
        <h1 class="auth-headline">Create Account</h1>
        <p class="auth-subline">Join LinkPulse with a secure developer account.</p>
      </div>

      <!-- Specific Validation Errors Display -->
      <% 
        const errList = (typeof errors !== 'undefined' && Array.isArray(errors) && errors.length > 0) 
          ? errors 
          : (typeof error !== 'undefined' && error ? [error] : []); 
      %>

      <% if (errList.length > 0) { %>
      <div class="alert alert-error" role="alert" id="signupErrorAlert">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <div class="alert-content">
          <div style="font-weight:600;margin-bottom:4px;">Please resolve the following:</div>
          <ul style="padding-left:1.25rem;margin:0;font-size:0.84rem;">
            <% errList.forEach(function(msg) { %>
              <li><%= msg %></li>
            <% }); %>
          </ul>
        </div>
      </div>
      <% } %>

      <!-- HTML Form Submission -->
      <form method="POST" action="/signup" class="auth-form" id="signupForm" novalidate>
        
        <% 
          const currentInput = (typeof oldInput !== 'undefined' && oldInput) 
            ? oldInput 
            : ((typeof formData !== 'undefined' && formData) ? formData : {});
        %>

        <!-- First & Last Name -->
        <div class="auth-row-2col">
          <div class="form-group">
            <label for="firstName">First name <span class="required">*</span></label>
            <input 
              type="text" 
              id="firstName" 
              name="firstName" 
              class="input" 
              placeholder="First name" 
              value="<%= currentInput.firstName || (currentInput.fullName ? currentInput.fullName.split(' ')[0] : '') %>" 
              required 
              autofocus 
            />
          </div>

          <div class="form-group">
            <label for="lastName">Last name <span class="hint">— optional</span></label>
            <input 
              type="text" 
              id="lastName" 
              name="lastName" 
              class="input" 
              placeholder="Last name" 
              value="<%= currentInput.lastName || (currentInput.fullName ? currentInput.fullName.split(' ').slice(1).join(' ') : '') %>" 
            />
          </div>
        </div>

        <input type="hidden" id="fullName" name="fullName" value="<%= currentInput.fullName || '' %>" />

        <!-- Email Address -->
        <div class="form-group">
          <label for="email">Email address <span class="required">*</span></label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            class="input" 
            placeholder="name@company.com" 
            value="<%= currentInput.email || '' %>" 
            required 
          />
        </div>

        <!-- Account Role Selection -->
        <div class="form-group">
          <label for="userType">Account Role <span class="required">*</span></label>
          <select id="userType" name="userType" class="input">
            <option value="user" <%= (!currentInput.userType || currentInput.userType === 'user' || currentInput.role === 'user') ? 'selected' : '' %>>Authorised User — Create, shorten and share personal links</option>
            <option value="admin" <%= (currentInput.userType === 'admin' || currentInput.role === 'admin') ? 'selected' : '' %>>Administrator — Full platform governance, kill-switch &amp; security</option>
            <option value="host" <%= (currentInput.userType === 'host' || currentInput.role === 'host') ? 'selected' : '' %>>Host — Team links, campaigns &amp; custom domains</option>
          </select>
        </div>

        <!-- Password Inputs -->
        <div class="auth-row-2col">
          <div class="form-group">
            <label for="password">Password <span class="required">*</span></label>
            <input 
              type="password" 
              id="password" 
              name="password" 
              class="input" 
              placeholder="Strong password" 
              required 
              autocomplete="new-password"
            />
          </div>

          <div class="form-group">
            <label for="confirmPassword">Confirm password <span class="required">*</span></label>
            <input 
              type="password" 
              id="confirmPassword" 
              name="confirmPassword" 
              class="input" 
              placeholder="Confirm password" 
              required 
              autocomplete="new-password"
            />
          </div>
        </div>

        <!-- Live Password Requirements Guide -->
        <div class="pwd-rules-container" id="pwdRulesBox">
          <div class="pwd-rules-heading">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <span>Password Requirements:</span>
          </div>

          <div class="pwd-rules-grid">
            <div class="pwd-rule-item" id="req-len">
              <span class="pwd-rule-dot">●</span>
              <span>At least <strong>6 chars</strong></span>
            </div>
            <div class="pwd-rule-item" id="req-upper">
              <span class="pwd-rule-dot">●</span>
              <span>One <strong>uppercase</strong> (A-Z)</span>
            </div>
            <div class="pwd-rule-item" id="req-lower">
              <span class="pwd-rule-dot">●</span>
              <span>One <strong>lowercase</strong> (a-z)</span>
            </div>
            <div class="pwd-rule-item" id="req-num">
              <span class="pwd-rule-dot">●</span>
              <span>One <strong>number</strong> (0-9)</span>
            </div>
            <div class="pwd-rule-item" id="req-spec">
              <span class="pwd-rule-dot">●</span>
              <span>Special char (!@#$%)</span>
            </div>
            <div class="pwd-rule-item" id="req-match">
              <span class="pwd-rule-dot">●</span>
              <span>Passwords <strong>match</strong></span>
            </div>
          </div>
        </div>

        <div class="form-group" style="margin-bottom:1.25rem;">
          <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;font-weight:400;color:var(--text-secondary);font-size:0.84rem;">
            <input type="checkbox" name="terms" id="terms" value="on" checked required style="accent-color:var(--primary);">
            <span>I agree to the Terms of Service &amp; Privacy Policy</span>
          </label>
        </div>

        <button type="submit" class="btn btn-primary" style="width:100%;min-height:42px;font-size:0.95rem;" id="submitSignupBtn">
          Create Account
        </button>
      </form>

      <div style="text-align:center;margin-top:1.5rem;font-size:0.85rem;color:var(--text-secondary);">
        <span>Already have an account?</span>
        <a href="/login" style="font-weight:600;color:var(--primary);margin-left:4px;">Sign in &rarr;</a>
      </div>

    </div>
  </div>
</main>

<%- include('partials/footer') %>

<script>
  (function() {
    const pwdInput = document.getElementById('password');
    const confirmInput = document.getElementById('confirmPassword');
    const firstName = document.getElementById('firstName');
    const lastName = document.getElementById('lastName');
    const fullName = document.getElementById('fullName');

    function syncFullName() {
      if (fullName) {
        fullName.value = ((firstName ? firstName.value : '') + ' ' + (lastName ? lastName.value : '')).trim();
      }
    }

    if (firstName) firstName.addEventListener('input', syncFullName);
    if (lastName) lastName.addEventListener('input', syncFullName);

    const rules = {
      len: document.getElementById('req-len'),
      upper: document.getElementById('req-upper'),
      lower: document.getElementById('req-lower'),
      num: document.getElementById('req-num'),
      spec: document.getElementById('req-spec'),
      match: document.getElementById('req-match')
    };

    function updateRule(element, isValid) {
      if (!element) return;
      if (isValid) {
        element.classList.add('valid');
      } else {
        element.classList.remove('valid');
      }
    }

    function checkPassword() {
      const val = pwdInput ? pwdInput.value : '';
      const confirmVal = confirmInput ? confirmInput.value : '';

      updateRule(rules.len, val.length >= 6);
      updateRule(rules.upper, /[A-Z]/.test(val));
      updateRule(rules.lower, /[a-z]/.test(val));
      updateRule(rules.num, /[0-9]/.test(val));
      updateRule(rules.spec, /[\W_]/.test(val));
      updateRule(rules.match, val.length > 0 && val === confirmVal);
    }

    if (pwdInput) {
      pwdInput.addEventListener('input', checkPassword);
    }
    if (confirmInput) {
      confirmInput.addEventListener('input', checkPassword);
    }

    checkPassword();
  })();
</script>

</body>
</html>

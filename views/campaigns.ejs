<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Campaigns — LinkPulse</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>

<%- include('partials/nav', { page: 'campaigns' }) %>

<main class="main-content">
  <div class="container">

    <div class="page-header">
      <div>
        <h1 class="page-title">Campaigns</h1>
        <p class="page-sub">Organise links into campaigns for grouped analytics.</p>
      </div>
    </div>

    <!-- Create campaign -->
    <div class="card" style="margin-bottom:1.75rem">
      <div class="card-title">Create Campaign</div>
      <form method="POST" action="/campaigns/new" class="inline-form">
        <input type="text" name="name" class="input" placeholder="Campaign name" required>
        <input type="text" name="tags" class="input" placeholder="Tags (comma-separated)">
        <button type="submit" class="btn btn-primary">Create</button>
      </form>
    </div>

    <!-- Campaigns grid -->
    <% if (campaigns.length === 0) { %>
      <div class="empty-state"><p>No campaigns yet.</p></div>
    <% } else { %>
    <div class="campaign-grid">
      <% campaigns.forEach(c => {
        const cLinks = links.filter(l => l.campaignId === c.id);
        const totalClicks = cLinks.reduce((s, l) => s + l.currentClicks, 0);
      %>
      <div class="card campaign-card">
        <div class="campaign-header">
          <div>
            <div class="campaign-name"><%= c.name %></div>
            <div class="campaign-meta">
              Created <%= new Date(c.createdAt).toLocaleDateString('en-GB', {day:'2-digit',month:'short',year:'numeric'}) %>
            </div>
          </div>
          <span class="badge badge-<%= c.status %>"><%= c.status %></span>
        </div>

        <div class="campaign-stats">
          <div class="cstat">
            <div class="cstat-val"><%= cLinks.length %></div>
            <div class="cstat-key">Links</div>
          </div>
          <div class="cstat">
            <div class="cstat-val"><%= totalClicks %></div>
            <div class="cstat-key">Total Clicks</div>
          </div>
        </div>

        <% if (c.tags && c.tags.length) { %>
        <div class="tag-row">
          <% c.tags.forEach(t => { %><span class="tag"><%= t %></span><% }) %>
        </div>
        <% } %>
      </div>
      <% }) %>
    </div>
    <% } %>

  </div>
</main>

<%- include('partials/footer') %>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Welcome to LinkPulse — High-Speed URL Governance &amp; Analytics Engine</title>
  <meta name="description" content="Shorten, govern, and monitor URLs with sub-10ms redirects, automated kill-switches, geo-telemetry, and dynamic QR codes. Built for developers, creators, and teams.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body class="welcome-page-body">

<%- include('partials/nav', { page: 'welcome' }) %>

<main class="main-content">
  <div class="welcome-hero-container">

    <!-- Top Announcement Pill -->
    <div class="welcome-badge-pill">
      <span class="badge-dot pulse-blue"></span>
      <span class="badge-pill-text">LinkPulse v2.6 &bull; Enterprise URL Governance &amp; Analytics</span>
      <a href="/signup" class="badge-pill-link">Get Started &rarr;</a>
    </div>

    <!-- Hero Header -->
    <div class="welcome-hero-header">
      <h1 class="welcome-hero-title">
        High-Speed URL Routing,<br/>
        <span class="welcome-gradient-text">Governed &amp; Monitored</span> in Real Time.
      </h1>
      <p class="welcome-hero-subtitle">
        Shorten, protect, and track every link with sub-10ms redirects, automated safety kill-switches, geo-telemetry, and dynamic QR codes. Designed for high-velocity teams, creators, and security-first organizations.
      </p>

      <!-- Primary Action Buttons (Ice-Smoothing Black & White with Blue CTA) -->
      <div class="welcome-hero-actions">
        <a href="/signup" class="btn btn-lg btn-primary welcome-btn-cta" id="welcomeHeroSignupBtn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/>
          </svg>
          <span>Create Free Account</span>
        </a>
        <a href="/login" class="btn btn-lg btn-ghost welcome-btn-login" id="welcomeHeroLoginBtn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/>
          </svg>
          <span>Sign In to Workspace</span>
        </a>
      </div>

      <!-- Quick Demo Access Prompt -->
      <div class="welcome-demo-banner">
        <div class="demo-badge">Quick Demo Access</div>
        <div class="demo-info">
          <span>Sign in instantly as Admin: <code>admin@linkpulse.io</code> / <code>password123</code></span>
        </div>
        <a href="/login?demo=admin" class="btn btn-sm btn-ghost demo-login-pill">One-Click Demo</a>
      </div>
    </div>

    <!-- Interactive Live Architecture & Redirection Showcase Card -->
    <div class="welcome-showcase-card">
      <div class="showcase-card-header">
        <div class="showcase-window-dots">
          <span class="dot-red"></span>
          <span class="dot-yellow"></span>
          <span class="dot-green"></span>
        </div>
        <div class="showcase-card-title">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
          </svg>
          <span>Live Redirection Engine &bull; Sub-10ms Benchmark</span>
        </div>
        <div class="showcase-latency-badge">&lt; 8.4 ms avg latency</div>
      </div>

      <div class="showcase-body">
        <div class="showcase-url-row">
          <div class="showcase-col">
            <span class="showcase-label">Short Governed URL</span>
            <div class="showcase-code-box">
              <span class="showcase-protocol">https://</span>
              <strong class="showcase-domain">linkpulse.io/</strong>
              <span class="showcase-slug">fest26</span>
              <span class="showcase-tag">Base62</span>
            </div>
          </div>

          <div class="showcase-arrow-wrap">
            <div class="showcase-arrow-pulse">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
              </svg>
            </div>
            <span class="showcase-speed-text">Instant 302</span>
          </div>

          <div class="showcase-col">
            <span class="showcase-label">Target Destination</span>
            <div class="showcase-code-box showcase-dest-box">
              <span class="showcase-dest-text">https://techgeeksfest.dev/register</span>
              <span class="badge badge-active showcase-status-badge">Active (200 OK)</span>
            </div>
          </div>
        </div>

        <!-- Metric Highlights in Showcase -->
        <div class="showcase-metrics-grid">
          <div class="showcase-metric-item">
            <span class="metric-val">142</span>
            <span class="metric-desc">Live Telemetry Clicks</span>
          </div>
          <div class="showcase-metric-item">
            <span class="metric-val">100%</span>
            <span class="metric-desc">Domain Health Score</span>
          </div>
          <div class="showcase-metric-item">
            <span class="metric-val">Desktop &bull; Mobile</span>
            <span class="metric-desc">OS Smart Routing</span>
          </div>
          <div class="showcase-metric-item">
            <span class="metric-val">Dynamic QR</span>
            <span class="metric-desc">Vector Sharing Ready</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ============================================================== -->
    <!-- SECTION 1: COMPREHENSIVE SERVICES -->
    <!-- ============================================================== -->
    <section class="welcome-section" id="services">
      <div class="section-title-wrap">
        <span class="section-eyebrow">Everything You Need</span>
        <h2 class="welcome-section-heading">Our Core Services &amp; Capabilities</h2>
        <p class="welcome-section-sub">
          Engineered from the ground up for speed, compliance, resilience, and maximum click engagement.
        </p>
      </div>

      <div class="services-grid">
        <!-- Service 1 -->
        <div class="service-card">
          <div class="service-icon-wrap icon-blue">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="13 2 13 9 20 9"/><path d="M20 9L13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/>
            </svg>
          </div>
          <h3 class="service-title">Sub-10ms Shortening &amp; Custom Slugs</h3>
          <p class="service-text">
            Shorten any destination URL with high-density Base62 encoding or define custom branded vanity aliases (e.g. <code>linkpulse.io/launch</code>). Redirection completes in under 10 milliseconds globally.
          </p>
          <div class="service-feature-tag">Base62 &bull; Vanity Aliases &bull; Sub-10ms</div>
        </div>

        <!-- Service 2 -->
        <div class="service-card">
          <div class="service-icon-wrap icon-blue">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <h3 class="service-title">Link Governance &amp; Emergency Kill-Switch</h3>
          <p class="service-text">
            Admins have instantaneous kill-switch controls to freeze abusive, phishing, or broken URLs across the entire platform in real time, while preserving historical audit trails and click counts.
          </p>
          <div class="service-feature-tag">Kill-Switch &bull; Domain Blacklisting &bull; Audit Trail</div>
        </div>

        <!-- Service 3 -->
        <div class="service-card">
          <div class="service-icon-wrap icon-blue">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>
            </svg>
          </div>
          <h3 class="service-title">Real-Time Deep Telemetry &amp; Live Stream</h3>
          <p class="service-text">
            Gain complete visibility into your audience. Track clicks by country flags, operating system, browser, referrer source, and stream live click events asynchronously without slowing down visitor redirects.
          </p>
          <div class="service-feature-tag">Geo-Location &bull; Device Stats &bull; Live Telemetry</div>
        </div>

        <!-- Service 4 -->
        <div class="service-card">
          <div class="service-icon-wrap icon-blue">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
            </svg>
          </div>
          <h3 class="service-title">Dynamic QR Codes &amp; Multi-Platform Sharing</h3>
          <p class="service-text">
            Every shortened link automatically receives an ultra-crisp vector QR code with custom sizing and downloads. Instantly share to WhatsApp, X (Twitter), LinkedIn, Email, or copy with one click.
          </p>
          <div class="service-feature-tag">Vector QR &bull; WhatsApp &bull; Twitter &bull; LinkedIn</div>
        </div>

        <!-- Service 5 -->
        <div class="service-card">
          <div class="service-icon-wrap icon-blue">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
          </div>
          <h3 class="service-title">Rule Gatekeeper &amp; Smart Device Routing</h3>
          <p class="service-text">
            Protect confidential documents with password verification, set hard expiration timestamps, or establish max click thresholds. Seamlessly route mobile users to dedicated mobile apps or alternate URLs.
          </p>
          <div class="service-feature-tag">Password Vault &bull; Click Caps &bull; Mobile Override</div>
        </div>

        <!-- Service 6 -->
        <div class="service-card">
          <div class="service-icon-wrap icon-blue">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <h3 class="service-title">Campaigns &amp; Multi-Tag Grouping</h3>
          <p class="service-text">
            Organize high-volume marketing initiatives into distinct campaigns. Tag links by channel (e.g., <code>promo</code>, <code>event</code>, <code>social</code>) to aggregate traffic across entire initiatives.
          </p>
          <div class="service-feature-tag">Campaigns &bull; Tag Clustering &bull; Multi-Channel</div>
        </div>
      </div>
    </section>

    <!-- ============================================================== -->
    <!-- SECTION 2: ROLE-BASED ACCESS CONTROL (RBAC) MATRIX -->
    <!-- ============================================================== -->
    <section class="welcome-section" id="roles">
      <div class="section-title-wrap">
        <span class="section-eyebrow">Enterprise Security</span>
        <h2 class="welcome-section-heading">Role-Based Access Control (RBAC)</h2>
        <p class="welcome-section-sub">
          Strict authorization boundaries ensure that only verified members can create and share links, while administrators retain global safety controls and guests are kept completely safe.
        </p>
      </div>

      <div class="roles-cards-grid">
        <!-- Guest Role Card -->
        <div class="role-box role-guest">
          <div class="role-box-header">
            <span class="role-badge role-badge-guest">Guest / Visitor</span>
            <span class="role-status-chip">Read-Only</span>
          </div>
          <h3 class="role-name">First-Time Visitors &amp; Guests</h3>
          <p class="role-desc">
            Anyone browsing without logging in. Fully protected with zero destructive capabilities.
          </p>
          <ul class="role-perms-list">
            <li class="perm-item allowed">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Explore services and site features on Welcome page</span>
            </li>
            <li class="perm-item allowed">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Redirect through active short links &amp; enter passwords</span>
            </li>
            <li class="perm-item denied">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              <span>Cannot create new short links</span>
            </li>
            <li class="perm-item denied">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              <span>Cannot delete or modify any links</span>
            </li>
            <li class="perm-item denied">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              <span>Cannot access protected workspace or admin controls</span>
            </li>
          </ul>
          <div class="role-cta-wrap">
            <a href="/signup" class="btn btn-sm btn-ghost" style="width:100%;">Create Account to Upgrade</a>
          </div>
        </div>

        <!-- Authorized User Role Card -->
        <div class="role-box role-user featured-role">
          <div class="role-featured-ribbon">Recommended for Creators</div>
          <div class="role-box-header">
            <span class="role-badge role-badge-user">Authorised User</span>
            <span class="role-status-chip chip-blue">Creator Workspace</span>
          </div>
          <h3 class="role-name">Registered Creators &amp; Marketers</h3>
          <p class="role-desc">
            Signed-up members with full link generation, QR creation, and multi-channel sharing privileges.
          </p>
          <ul class="role-perms-list">
            <li class="perm-item allowed">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Create unlimited short links with custom aliases</span>
            </li>
            <li class="perm-item allowed">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Generate vector QR codes and send links via social channels</span>
            </li>
            <li class="perm-item allowed">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Configure expiration timers, password locks &amp; mobile URLs</span>
            </li>
            <li class="perm-item allowed">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Manage &amp; toggle active status of own links</span>
            </li>
            <li class="perm-item allowed">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>View dedicated analytics dashboard for personal links</span>
            </li>
            <li class="perm-item denied">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              <span>Cannot modify or delete other users' links or system blocklists</span>
            </li>
          </ul>
          <div class="role-cta-wrap">
            <a href="/signup" class="btn btn-sm btn-primary" style="width:100%;">Sign Up as User</a>
          </div>
        </div>

        <!-- Administrator Role Card -->
        <div class="role-box role-admin">
          <div class="role-box-header">
            <span class="role-badge role-badge-admin">Administrator</span>
            <span class="role-status-chip chip-gold">Full Control</span>
          </div>
          <h3 class="role-name">System Admins &amp; Security Leads</h3>
          <p class="role-desc">
            Complete platform-wide authority. Total visibility over all links, telemetry, and security policies.
          </p>
          <ul class="role-perms-list">
            <li class="perm-item allowed">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>All Creator &amp; User privileges included</span>
            </li>
            <li class="perm-item allowed">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Platform-wide link visibility across all users</span>
            </li>
            <li class="perm-item allowed">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Instant Kill-Switch: Disable or delete any malicious link</span>
            </li>
            <li class="perm-item allowed">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Manage global Domain Blocklist to prevent phishing</span>
            </li>
            <li class="perm-item allowed">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Access global infrastructure telemetry &amp; live click logs</span>
            </li>
          </ul>
          <div class="role-cta-wrap">
            <a href="/login?demo=admin" class="btn btn-sm btn-ghost" style="width:100%;">Sign In as Admin</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================== -->
    <!-- SECTION 3: HOW IT WORKS (3 SIMPLE STEPS) -->
    <!-- ============================================================== -->
    <section class="welcome-section" id="how-it-works">
      <div class="section-title-wrap">
        <span class="section-eyebrow">Seamless Flow</span>
        <h2 class="welcome-section-heading">How LinkPulse Works</h2>
        <p class="welcome-section-sub">From raw URL to governed, high-converting short link in seconds.</p>
      </div>

      <div class="steps-flow-grid">
        <div class="step-card">
          <div class="step-card-num">01</div>
          <h4 class="step-card-title">Create Account or Sign In</h4>
          <p class="step-card-text">
            Join in 10 seconds. Your workspace automatically configures based on your role, ready with analytics and campaign containers.
          </p>
        </div>

        <div class="step-card">
          <div class="step-card-num">02</div>
          <h4 class="step-card-title">Paste &amp; Configure Rules</h4>
          <p class="step-card-text">
            Input your destination URL, choose a memorable alias, and optionally attach password locks, expiry timers, or mobile device overrides.
          </p>
        </div>

        <div class="step-card">
          <div class="step-card-num">03</div>
          <h4 class="step-card-title">Share, Scan &amp; Monitor</h4>
          <p class="step-card-text">
            Copy the link or download high-resolution QR codes. Share directly to WhatsApp, Twitter, and LinkedIn while telemetry tracks every single click.
          </p>
        </div>
      </div>
    </section>

    <!-- ============================================================== -->
    <!-- BOTTOM CALL TO ACTION BANNER -->
    <!-- ============================================================== -->
    <div class="welcome-bottom-banner">
      <div class="banner-content">
        <h3 class="banner-title">Ready to Experience Modern Link Governance?</h3>
        <p class="banner-sub">
          Create your account today or sign in to access your dashboard, shorten links, and inspect real-time telemetry.
        </p>
      </div>
      <div class="banner-actions">
        <a href="/signup" class="btn btn-lg btn-primary" id="bottomBannerSignupBtn">
          Create Free Account &rarr;
        </a>
        <a href="/login" class="btn btn-lg btn-ghost" id="bottomBannerLoginBtn">
          Sign In
        </a>
      </div>
    </div>

  </div>
</main>

<%- include('partials/footer') %>

</body>
</html>

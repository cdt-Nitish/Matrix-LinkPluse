<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>LinkPulse — Short links. Clear insights.</title>
  <meta name="description" content="Create short links, share them anywhere, and track their performance with simple, useful analytics.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body class="landing-page">

  <!-- Compact Landing Navbar -->
  <header class="landing-nav-container">
    <div class="container">
      <nav class="landing-navbar" aria-label="Main Navigation">
        <!-- Brand -->
        <a href="/" class="landing-brand" id="landingBrandLink">
          <div class="sidebar-logo-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="13 2 13 9 20 9"/>
              <path d="M20 9L13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/>
            </svg>
          </div>
          <span>LinkPulse</span>
        </a>

        <!-- Desktop Navigation Links -->
        <div class="landing-nav-right">
          <a href="#features" class="landing-nav-link">Features</a>
          <a href="#how-it-works" class="landing-nav-link">How It Works</a>
          <a href="/login" class="landing-nav-link">Sign In</a>
          <a href="/signup" class="btn btn-primary btn-sm" id="landingGetStartedBtn">Get Started</a>
        </div>

        <!-- Mobile Menu Toggle Button -->
        <button type="button" class="landing-mobile-menu-btn" id="landingMobileMenuToggle" aria-label="Toggle mobile menu" onclick="toggleLandingMenu()">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>
      </nav>
    </div>

    <!-- Mobile Drawer Menu -->
    <div class="landing-mobile-menu" id="landingMobileMenu">
      <a href="#features" class="landing-nav-link" onclick="closeLandingMenu()">Features</a>
      <a href="#how-it-works" class="landing-nav-link" onclick="closeLandingMenu()">How It Works</a>
      <div class="landing-mobile-actions">
        <a href="/login" class="btn btn-ghost btn-sm" style="width:100%;">Sign In</a>
        <a href="/signup" class="btn btn-primary btn-sm" style="width:100%;">Get Started</a>
      </div>
    </div>
  </header>

  <main class="main-content">
    <!-- Hero Section (Clean Two-Column Layout) -->
    <section class="landing-hero-section">
      <div class="container">
        <div class="landing-hero-grid">
          
          <!-- Hero Content (Left) -->
          <div class="landing-hero-left">
            <div class="landing-label-pill">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 14 14"/>
              </svg>
              <span>Simple. Secure. Trackable.</span>
            </div>

            <h1 class="landing-hero-title">
              Short links.<br/>
              <span class="highlight-blue">Clear insights.</span>
            </h1>

            <p class="landing-hero-desc">
              Create short links, share them anywhere, and track their performance with simple, useful analytics.
            </p>

            <div class="landing-hero-cta">
              <a href="/signup" class="btn btn-primary btn-lg" id="heroGetStartedCta">Get Started Free</a>
              <a href="/login" class="btn btn-ghost btn-lg" id="heroSignInCta">Sign In</a>
            </div>
          </div>

          <!-- Product Preview (Right Column) -->
          <div class="landing-hero-right">
            <div class="product-preview-card" id="productPreviewCard">
              <div class="preview-top-bar">
                <div class="preview-dot-group">
                  <span class="preview-dot"></span>
                  <span class="preview-dot"></span>
                  <span class="preview-dot"></span>
                </div>
                <div class="preview-title">LinkPulse Preview</div>
              </div>

              <div class="preview-form">
                <label for="previewUrlInput" style="font-size:0.78rem;color:var(--text-secondary);font-weight:600;">Destination URL</label>
                <div class="preview-input-row">
                  <input
                    type="url"
                    id="previewUrlInput"
                    class="input preview-input"
                    value="https://example.com/company-launch"
                    placeholder="https://yourlink.com/long-page-url"
                  />
                  <button type="button" class="btn btn-primary preview-short-btn" id="previewShortenBtn" onclick="simulateShorten()">
                    Shorten
                  </button>
                </div>

                <div class="preview-result-box" id="previewResultBox">
                  <div class="preview-link-info">
                    <div class="preview-link-label">Generated Link</div>
                    <div class="preview-link-val" id="previewGeneratedLink">linkpulse.io/launch</div>
                  </div>
                  <button type="button" class="btn btn-ghost btn-sm" id="previewCopyBtn" onclick="copyPreviewLink()">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                    </svg>
                    <span id="previewCopyText">Copy</span>
                  </button>
                </div>

                <div class="preview-counter-footer">
                  <span>Live Click Counter:</span>
                  <span class="preview-stat-pill" id="previewClickCount">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color:var(--primary);">
                      <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
                      <polyline points="17 6 23 6 23 12"/>
                    </svg>
                    <span id="clickNumber">1,428 clicks</span>
                  </span>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Minimal Features Section (Only Three Key Features) -->
    <section class="landing-features-section" id="features">
      <div class="container">
        <div class="features-grid">
          
          <!-- Feature 1: Shorten Links -->
          <div class="feature-card">
            <div class="feature-icon-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
              </svg>
            </div>
            <h2 class="feature-heading">Shorten Links</h2>
            <p class="feature-description">
              Turn long URLs into shareable links. Create custom memorable aliases in seconds with high-speed redirects.
            </p>
          </div>

          <!-- Feature 2: Track Clicks -->
          <div class="feature-card">
            <div class="feature-icon-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="20" x2="18" y2="10"/>
                <line x1="12" y1="20" x2="12" y2="4"/>
                <line x1="6" y1="20" x2="6" y2="14"/>
              </svg>
            </div>
            <h2 class="feature-heading">Track Clicks</h2>
            <p class="feature-description">
              Understand how people interact with your links. Monitor click volume, device types, and traffic channels accurately.
            </p>
          </div>

          <!-- Feature 3: Manage Links -->
          <div class="feature-card">
            <div class="feature-icon-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7"/>
                <rect x="14" y="3" width="7" height="7"/>
                <rect x="14" y="14" width="7" height="7"/>
                <rect x="3" y="14" width="7" height="7"/>
              </svg>
            </div>
            <h2 class="feature-heading">Manage Links</h2>
            <p class="feature-description">
              Keep your shortened URLs organized. Group links into campaigns, set expirations, and enable password protection easily.
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- How It Works Section (Subtle anchor section) -->
    <section id="how-it-works" style="padding: 2.5rem 0; border-top: 1px solid var(--border); background-color: var(--bg-main);">
      <div class="container" style="max-width: 800px; text-align: center;">
        <h2 style="font-size: 1.5rem; font-weight: 700; color: var(--dark-navy); margin-bottom: 0.5rem;">How LinkPulse Works</h2>
        <p style="color: var(--text-secondary); font-size: 0.95rem; margin-bottom: 2rem;">
          Three simple steps to publish and monitor your links.
        </p>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; text-align: left;">
          <div style="padding: 1.25rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-secondary);">
            <div style="font-weight: 700; color: var(--primary); font-size: 1.25rem; margin-bottom: 0.35rem;">1. Paste URL</div>
            <p style="font-size: 0.85rem; color: var(--text-secondary);">Enter your long web address and optionally specify a custom slug or campaign.</p>
          </div>
          <div style="padding: 1.25rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-secondary);">
            <div style="font-weight: 700; color: var(--primary); font-size: 1.25rem; margin-bottom: 0.35rem;">2. Share Anywhere</div>
            <p style="font-size: 0.85rem; color: var(--text-secondary);">Copy your clean short link or download an instant dynamic QR code.</p>
          </div>
          <div style="padding: 1.25rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-secondary);">
            <div style="font-weight: 700; color: var(--primary); font-size: 1.25rem; margin-bottom: 0.35rem;">3. Review Telemetry</div>
            <p style="font-size: 0.85rem; color: var(--text-secondary);">Track real-time visits, geographic sources, and referrers on your dashboard.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Compact Final CTA Section -->
    <section class="landing-cta-banner">
      <div class="container">
        <div class="cta-banner-inner">
          <h2 class="cta-banner-title">Ready to simplify your links?</h2>
          <a href="/signup" class="btn btn-primary btn-lg" id="finalGetStartedCta">Get Started Free</a>
        </div>
      </div>
    </section>
  </main>

  <!-- Clean Minimal Footer -->
  <footer class="landing-footer">
    <div class="container">
      <div class="landing-footer-inner">
        <div style="display:flex;align-items:center;gap:0.5rem;">
          <div class="sidebar-logo-icon" style="width:24px;height:24px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px;">
              <polyline points="13 2 13 9 20 9"/>
              <path d="M20 9L13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/>
            </svg>
          </div>
          <strong style="color:var(--dark-navy);font-size:0.95rem;">LinkPulse</strong>
        </div>

        <div class="landing-footer-links">
          <a href="#features" class="landing-footer-link">Features</a>
          <a href="#how-it-works" class="landing-footer-link">How It Works</a>
          <a href="/login" class="landing-footer-link">Sign In</a>
          <a href="/signup" class="landing-footer-link">Sign Up</a>
        </div>

        <div class="landing-copyright">
          &copy; <%= new Date().getFullYear() %> LinkPulse. All rights reserved.
        </div>
      </div>
    </div>
  </footer>

  <!-- Toast Notification element for copy feedback -->
  <div class="toast-container" id="toastContainer">
    <div class="toast" id="landingToast">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
      <span id="landingToastMsg">Copied to clipboard!</span>
    </div>
  </div>

  <script>
    // Mobile navigation toggle
    function toggleLandingMenu() {
      const menu = document.getElementById('landingMobileMenu');
      if (menu) menu.classList.toggle('open');
    }

    function closeLandingMenu() {
      const menu = document.getElementById('landingMobileMenu');
      if (menu) menu.classList.remove('open');
    }

    // Interactive product preview simulation
    let currentClickCount = 1428;
    function simulateShorten() {
      const input = document.getElementById('previewUrlInput');
      const genLink = document.getElementById('previewGeneratedLink');
      const clickEl = document.getElementById('clickNumber');
      if (!input || !genLink) return;

      const urlVal = input.value.trim();
      let slug = 'launch';
      try {
        if (urlVal) {
          const parsed = new URL(urlVal.startsWith('http') ? urlVal : 'https://' + urlVal);
          const parts = parsed.pathname.split('/').filter(Boolean);
          if (parts.length > 0) {
            slug = parts[parts.length - 1].slice(0, 10).toLowerCase().replace(/[^a-z0-9]/g, '');
          }
        }
      } catch (e) {
        slug = 'custom' + Math.floor(Math.random() * 90 + 10);
      }
      if (!slug) slug = 'link' + Math.floor(Math.random() * 90 + 10);

      genLink.textContent = 'linkpulse.io/' + slug;
      currentClickCount += 1;
      if (clickEl) clickEl.textContent = currentClickCount.toLocaleString() + ' clicks';
      showToast('Link created: linkpulse.io/' + slug);
    }

    function copyPreviewLink() {
      const genLink = document.getElementById('previewGeneratedLink');
      const copyText = document.getElementById('previewCopyText');
      if (!genLink) return;

      const fullUrl = window.location.origin + '/' + genLink.textContent.split('/').pop();
      navigator.clipboard.writeText(fullUrl).then(() => {
        if (copyText) copyText.textContent = 'Copied!';
        showToast('Link copied to clipboard');
        setTimeout(() => {
          if (copyText) copyText.textContent = 'Copy';
        }, 2000);
      }).catch(() => {
        if (copyText) copyText.textContent = 'Copied!';
        setTimeout(() => {
          if (copyText) copyText.textContent = 'Copy';
        }, 2000);
      });
    }

    function showToast(msg) {
      const toast = document.getElementById('landingToast');
      const toastMsg = document.getElementById('landingToastMsg');
      if (!toast) return;
      if (toastMsg && msg) toastMsg.textContent = msg;
      toast.classList.add('show');
      setTimeout(() => {
        toast.classList.remove('show');
      }, 2500);
    }
  </script>
</body>
</html>

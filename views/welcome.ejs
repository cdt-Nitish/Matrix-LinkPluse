                      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                    </svg>
                    <span id="copyBtnLabel">Copy</span>
                  </button>
                </div>

                <!-- Divider -->
                <div class="preview-divider" aria-hidden="true"></div>

                <!-- Click Counter / Telemetry -->
                <div class="preview-telemetry-row">
                  <div class="telemetry-info">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--primary);flex-shrink:0;">
                      <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
                    </svg>
                    <span class="telemetry-label" id="telemetryStatusLabel">Live Sample Telemetry</span>
                  </div>
                  <div class="telemetry-pill" id="telemetryPill">
                    <span id="previewClickCountNum">1,428</span> clicks

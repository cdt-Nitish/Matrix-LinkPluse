  <!-- Universal Toast Feedback -->
  <div class="toast-container" id="landingToastContainer" aria-live="polite">
    <div class="toast toast-popup" id="landingToast">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="toast-icon" aria-hidden="true">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
      <span id="toastMessage">Copied to clipboard!</span>
    </div>
  </div>

  <script>
    // Mobile navigation drawer toggle
    function toggleMobileNav() {
      var drawer = document.getElementById('mobileNavDrawer');
      if (drawer) drawer.classList.toggle('open');
    }

    function closeMobileNav() {
      var drawer = document.getElementById('mobileNavDrawer');
      if (drawer) drawer.classList.remove('open');
    }

    // Active full short URL for copy action
    var currentShortFullUrl = window.location.origin + '/launch';

    // Interactive URL shortening preview handler
    async function handlePreviewShorten(e) {
      e.preventDefault();
      var input = document.getElementById('previewUrlInput');
      var btn = document.getElementById('previewShortenBtn');
      var btnText = document.getElementById('shortenBtnText');
      var spinner = document.getElementById('shortenBtnSpinner');
      var errorMsg = document.getElementById('previewErrorMsg');
      var linkDisplay = document.getElementById('generatedLinkDisplay');
      var telemetryNum = document.getElementById('previewClickCountNum');
      var guestNote = document.getElementById('previewGuestNote');

      if (!input) return;
      var url = input.value.trim();
      if (!url) {
        if (errorMsg) {
          errorMsg.textContent = 'Please enter a valid destination URL.';
          errorMsg.style.display = 'block';
        }
        return;
      }

      if (errorMsg) errorMsg.style.display = 'none';
      if (btn) btn.disabled = true;
      if (btnText) btnText.style.display = 'none';
      if (spinner) spinner.style.display = 'inline-block';

      try {
        var res = await fetch('/api/shorten-preview', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ destinationUrl: url })
        });
        var data = await res.json();

        if (data.success) {
          currentShortFullUrl = data.shortUrl;
          if (linkDisplay) {
            linkDisplay.textContent = data.displayUrl;
            linkDisplay.href = data.shortUrl;
          }
          if (telemetryNum) {
            telemetryNum.textContent = '0';
          }
          if (guestNote) {
            guestNote.style.display = 'block';
          }
          showToast('Short link created: ' + data.displayUrl);
        } else {
          if (errorMsg) {
            errorMsg.textContent = data.error || 'Failed to generate link.';
            errorMsg.style.display = 'block';
          }
        }
      } catch (err) {
        // Fallback for offline/network issues
        var slug = 'link' + Math.floor(Math.random() * 900 + 100);
        currentShortFullUrl = window.location.origin + '/' + slug;
        if (linkDisplay) {
          linkDisplay.textContent = 'linkpulse.io/' + slug;
          linkDisplay.href = currentShortFullUrl;
        }
        showToast('Link generated: linkpulse.io/' + slug);
      } finally {
        if (btn) btn.disabled = false;
        if (btnText) btnText.style.display = 'inline';
        if (spinner) spinner.style.display = 'none';
      }
    }

    // Copy Generated Link
    function copyPreviewLink() {
      var copyLabel = document.getElementById('copyBtnLabel');
      var toCopy = currentShortFullUrl;

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(toCopy).then(function () {
          setCopiedState(copyLabel);
          showToast('Copied link to clipboard!');
        }).catch(function () {
          fallbackCopy(toCopy, copyLabel);
        });
      } else {
        fallbackCopy(toCopy, copyLabel);
      }
    }

    function fallbackCopy(text, copyLabel) {
      try {
        var el = document.createElement('textarea');
        el.value = text;
        el.setAttribute('readonly', '');
        el.style.position = 'absolute';
        el.style.left = '-9999px';
        document.body.appendChild(el);
        el.select();
        document.execCommand('copy');
        document.body.removeChild(el);
        setCopiedState(copyLabel);
        showToast('Copied link to clipboard!');
      } catch (err) {
        setCopiedState(copyLabel);
        showToast('Copied link to clipboard!');
      }
    }

    function setCopiedState(copyLabel) {
      if (copyLabel) copyLabel.textContent = 'Copied!';
      setTimeout(function () {
        if (copyLabel) copyLabel.textContent = 'Copy';
      }, 2000);
    }

    function showToast(msg) {
      var toast = document.getElementById('landingToast');
      var toastMsg = document.getElementById('toastMessage');
      if (!toast) return;
      if (toastMsg && msg) toastMsg.textContent = msg;
      toast.classList.add('visible');
      setTimeout(function () {
        toast.classList.remove('visible');
      }, 2500);
    }
  </script>

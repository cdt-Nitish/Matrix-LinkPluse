                </svg>
              </a>
              <a href="/login" class="btn-hero-secondary" id="heroSignInCta">
                Sign In
              </a>
            </div>
          </div>

          <!-- Right Column: URL Shortener Preview Card (48%) -->
          <div class="hero-right-column">
            <div class="browser-preview-card" id="urlPreviewCard">
              <!-- Browser Window Header -->
              <div class="browser-header">
                <div class="browser-dots" aria-hidden="true">
                  <span class="b-dot dot-red"></span>
                  <span class="b-dot dot-yellow"></span>
                  <span class="b-dot dot-green"></span>
                </div>
                <div class="browser-title">LINKPULSE PREVIEW</div>
              </div>

              <!-- Preview Form Body -->
              <div class="browser-body">
                <form id="previewShortenForm" class="preview-form" onsubmit="handlePreviewShorten(event)">
                  <label for="previewUrlInput" class="preview-field-label">Destination URL</label>
                  <div class="preview-input-row">
                    <input 
                      type="url" 
                      id="previewUrlInput" 
                      class="preview-input-field" 
                      value="https://example.com/company-launch"
                      placeholder="https://example.com/long-page-url" 
                      required
                      autocomplete="off"
                    />
                    <button type="submit" class="btn-preview-shorten" id="previewShortenBtn">
                      <span id="shortenBtnText">Shorten</span>
                      <svg class="preview-spinner" id="shortenBtnSpinner" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" style="display:none;" aria-hidden="true">
                        <circle cx="12" cy="12" r="10" stroke-dasharray="32" stroke-dashoffset="12"/>
                      </svg>
                    </button>
                  </div>
                  <!-- Error notice area -->
                  <div class="preview-error-msg" id="previewErrorMsg" style="display:none;" role="alert"></div>
                </form>

                <!-- Generated Link Panel -->
                <div class="generated-link-panel" id="generatedLinkPanel">
                  <div class="generated-link-left">
                    <div class="generated-link-label">Generated Link</div>
                    <a href="javascript:void(0)" class="generated-link-url" id="generatedLinkDisplay" target="_blank" rel="noopener">linkpulse.io/launch</a>
                  </div>
                  <button type="button" class="btn-preview-copy" id="previewCopyBtn" onclick="copyPreviewLink()" aria-label="Copy short link">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">

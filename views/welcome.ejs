          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="13 2 13 9 20 9"/>
            <path d="M20 9L13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/>
          </svg>
        </div>
        <span class="landing-wordmark">LinkPulse</span>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="landing-nav-center" aria-label="Main Navigation">
        <a href="#features" class="landing-nav-link">Features</a>
        <a href="#how-it-works" class="landing-nav-link">How It Works</a>
        <a href="#pricing" class="landing-nav-link">Pricing</a>
        <a href="/login" class="landing-nav-link">Sign In</a>
      </nav>

      <!-- Desktop Right Controls: Exactly ONE Theme Toggle & Get Started -->

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin &amp; Security — LinkPulse</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
  <%- include('partials/theme-head') %>
</head>
<body class="app-layout">
<%- include('partials/nav', { page: 'admin' }) %>

<main class="main-content">
  <!-- Authenticated Topbar -->
  <div class="app-topbar">
    <div class="topbar-left">
      <button type="button" class="topbar-drawer-btn" aria-label="Toggle navigation drawer" onclick="toggleSidebarDrawer()">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <span class="topbar-page-label">Admin &amp; Security</span>
    </div>
    <div class="topbar-right">
      <button type="button" class="theme-toggle-btn" data-theme-toggle aria-label="Toggle theme" title="Toggle theme" style="width:36px;height:36px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="theme-icon-sun" aria-hidden="true">
          <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
      </button>
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/profile" class="topbar-user-pill" title="View Profile">
          <span class="topbar-avatar"><%= (user.fullName ? user.fullName[0] : (user.username ? user.username[0] : 'U')).toUpperCase() %></span>
          <span><%= user.fullName ? user.fullName.split(' ')[0] : user.username %></span>
        </a>
      <% } %>
      <a href="/links/new" class="btn btn-primary btn-sm">+ New Link</a>
    </div>
  </div>

  <div class="container">

    <div class="page-header">
      <div>
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:4px;flex-wrap:wrap;">
          <h1 class="page-title">Admin &amp; Security</h1>
          <span class="badge badge-admin">Admin Role &bull; Global Kill-Switch &amp; Blocklist</span>
        </div>
        <p class="page-sub">Global kill-switch controls, system redirects, and domain blocklist.</p>
      </div>
      <a href="/links/new" class="btn btn-primary">+ New Link</a>
    </div>

    <!-- All Links -->
    <div class="section">
      <div class="section-header">
        <h2 class="section-title">Network Endpoints</h2>
        <span class="tag"><%= links.length %> total links</span>
      </div>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th style="width:160px;">Short URL</th>
              <th>Destination</th>
              <th style="text-align:right;width:90px;">Clicks</th>
              <th style="width:90px;">Status</th>
              <th style="width:120px;">Created</th>
              <th style="text-align:right;width:160px;">Action</th>
            </tr>
          </thead>
          <tbody>
            <% links.forEach(link => { %>
            <tr>
              <td>
                <div style="display:flex;align-items:center;gap:6px">
                  <a href="/<%= link.shortCode %>" target="_blank" class="code-link">/<%= link.shortCode %></a>
                  <button type="button" class="btn-action" title="Copy Short Link" onclick="copyLink('<%= link.shortCode %>', this)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                  </button>
                  <button type="button" class="btn-action" title="Share Link &amp; QR" onclick="openShareModal('<%= link.shortCode %>', '<%= encodeURIComponent(link.title || '') %>', '<%= encodeURIComponent(link.originalUrl || '') %>')">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
                  </button>
                </div>
              </td>
              <td class="link-dest"><%= link.originalUrl %></td>
              <td style="text-align:right; font-weight:600; color:var(--dark-navy);"><%= link.currentClicks.toLocaleString() %></td>
              <td><span class="badge badge-<%= link.status %>"><%= link.status %></span></td>
              <td class="muted" style="font-size:0.8rem;color:var(--text-secondary);">
                <%= new Date(link.createdAt).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}) %>
              </td>
              <td style="text-align:right">
                <div style="display:inline-flex;align-items:center;gap:6px">
                  <form method="POST" action="/admin/links/<%= link.shortCode %>/toggle" style="margin:0">
                    <button type="submit" class="btn btn-sm <%= link.status === 'active' ? 'btn-ghost' : 'btn-primary' %>" title="<%= link.status === 'active' ? 'Disable link' : 'Enable link' %>">
                      <%= link.status === 'active' ? 'Disable' : 'Enable' %>
                    </button>
                  </form>
                  <form method="POST" action="/admin/links/<%= link.shortCode %>/delete" onsubmit="return confirm('Permanently delete /<%= link.shortCode %>? This action cannot be undone.')" style="margin:0">
                    <button type="submit" class="btn btn-sm btn-ghost" style="color:var(--error);" title="Delete link">
                      Delete
                    </button>
                  </form>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Domain Blocklist -->
    <div class="section">
      <div class="section-header">
        <h2 class="section-title">Domain Blocklist</h2>
      </div>

      <div class="card" style="margin-bottom:1rem">
        <form method="POST" action="/admin/domains/block" style="display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;">
          <div style="flex:1;min-width:200px;">
            <label for="blockDomainInput">Domain name <span class="required">*</span></label>
            <input type="text" id="blockDomainInput" name="domain" class="input" placeholder="e.g. phishing-site.com" required>
          </div>
          <div style="flex:1;min-width:200px;">
            <label for="blockReasonInput">Reason <span class="hint">— optional</span></label>
            <input type="text" id="blockReasonInput" name="reason" class="input" placeholder="e.g. Malware, Suspicious">
          </div>
          <button type="submit" class="btn btn-danger">Block Domain</button>
        </form>
      </div>

      <% if (blockedDomains.length === 0) { %>
        <div class="card" style="text-align:center;padding:2rem;"><p class="muted" style="color:var(--text-secondary);">No domains blocked.</p></div>
      <% } else { %>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>Domain</th>
              <th>Reason</th>
              <th>Blocked Date</th>
              <th style="text-align:right">Action</th>
            </tr>
          </thead>
          <tbody>
            <% blockedDomains.forEach(d => { %>
            <tr>
              <td><code style="color:var(--error);background:var(--error-light);padding:2px 6px;border-radius:4px;border:1px solid var(--error-border);"><%= d.domain %></code></td>
              <td><%= d.reason || '—' %></td>
              <td class="muted" style="font-size:0.8rem;color:var(--text-secondary);">
                <%= new Date(d.createdAt).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}) %>
              </td>
              <td style="text-align:right">
                <form method="POST" action="/admin/domains/<%= encodeURIComponent(d.domain) %>/unblock" style="margin:0;display:inline;">
                  <button type="submit" class="btn btn-sm btn-ghost" title="Unblock domain">
                    Unblock
                  </button>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>

  </div>
</main>

<%- include('partials/share-modal') %>
<%- include('partials/footer') %>
</body>
</html>

<% 
  const isAuth = typeof user !== 'undefined' && user !== null;
  const userRole = isAuth ? (user.role || user.userType || 'user').toLowerCase() : 'guest';
  const isAdmin = userRole === 'admin' || userRole === 'host';
  const currentPage = typeof page !== 'undefined' ? page : '';
%>

<!-- Mobile Navigation Bar (visible <= 1024px) -->
<div class="mobile-topbar" id="mobileTopbar">
  <div style="display:flex;align-items:center;gap:0.75rem;">
    <button type="button" class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle navigation drawer" onclick="toggleSidebarDrawer()">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
    <a href="/" class="mobile-brand">
      <div class="sidebar-logo-icon" style="width:28px;height:28px;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;">
          <polyline points="13 2 13 9 20 9"/><path d="M20 9L13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/>
        </svg>
      </div>
      <span>LinkPulse</span>
    </a>
  </div>

  <div class="mobile-right-actions">
    <% if (isAuth) { %>
      <a href="/links/new" class="btn btn-sm btn-primary">+ New Link</a>
    <% } else { %>
      <a href="/login" class="btn btn-sm btn-ghost">Sign In</a>
      <a href="/signup" class="btn btn-sm btn-primary">Sign Up</a>
    <% } %>
  </div>
</div>

<!-- Backdrop Overlay for Mobile Drawer -->
<div class="mobile-sidebar-backdrop" id="mobileSidebarBackdrop" onclick="closeSidebarDrawer()"></div>

<!-- LinkPulse Authenticated Sidebar -->
<aside class="app-sidebar" id="appSidebar">
  <!-- Brand Section -->
  <div class="sidebar-brand-section">
    <div style="display:flex;align-items:center;justify-content:space-between;width:100%;">
      <a href="/" class="sidebar-brand" id="sidebarBrandLink">
        <div class="sidebar-logo-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="13 2 13 9 20 9"/><path d="M20 9L13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/>
          </svg>
        </div>
        <span class="brand-name">LinkPulse</span>
        <span class="brand-tag">v2.6</span>
      </a>
      <button type="button" class="btn-action mobile-menu-toggle" style="display:none;" onclick="closeSidebarDrawer()" title="Close menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>

  <!-- Primary CTA Area -->
  <div class="sidebar-cta-wrap">
    <% if (isAuth) { %>
      <a href="/links/new" class="sidebar-create-btn" id="sidebarCreateLinkBtn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        <span>+ New Link</span>
      </a>
    <% } else { %>
      <a href="/signup" class="sidebar-create-btn" id="sidebarGuestCtaBtn">
        <span>Get Started Free</span>
      </a>
    <% } %>
  </div>

  <!-- Sidebar Navigation Links -->
  <nav class="sidebar-nav">
    <% if (isAuth) { %>
      <div class="sidebar-section-title">Workspace</div>

      <a href="/" class="sidebar-nav-item <%= currentPage === 'dashboard' ? 'active' : '' %>" id="navDashboardLink">
        <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
        </svg>
        <span class="nav-item-text">Dashboard</span>
      </a>

      <a href="/analytics" class="sidebar-nav-item <%= currentPage === 'analytics' ? 'active' : '' %>" id="navAnalyticsLink">
        <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>
        </svg>
        <span class="nav-item-text"><%= isAdmin ? 'Platform Analytics' : 'My Analytics' %></span>
      </a>

      <a href="/campaigns" class="sidebar-nav-item <%= currentPage === 'campaigns' ? 'active' : '' %>" id="navCampaignsLink">
        <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
        </svg>
        <span class="nav-item-text">Campaigns</span>
      </a>

      <% if (isAdmin) { %>
        <div class="sidebar-section-title" style="margin-top:0.75rem;">Administration</div>

        <a href="/admin" class="sidebar-nav-item <%= currentPage === 'admin' ? 'active' : '' %>" id="navAdminLink">
          <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          <span class="nav-item-text">Admin &amp; Security</span>
          <span class="nav-item-badge admin-chip">ADMIN</span>
        </a>
      <% } %>

    <% } else { %>
      <div class="sidebar-section-title">Navigation</div>
      <a href="/" class="sidebar-nav-item <%= currentPage === 'welcome' ? 'active' : '' %>">
        <span class="nav-item-text">Home</span>
      </a>
      <a href="/login" class="sidebar-nav-item <%= currentPage === 'login' ? 'active' : '' %>">
        <span class="nav-item-text">Sign In</span>
      </a>
      <a href="/signup" class="sidebar-nav-item <%= currentPage === 'signup' ? 'active' : '' %>">
        <span class="nav-item-text">Sign Up</span>
      </a>
    <% } %>
  </nav>

  <!-- Sidebar User Auth Footer -->
  <div class="sidebar-auth-section">
    <% if (isAuth) { %>
      <div class="sidebar-user-card">
        <a href="/profile" class="sidebar-user-info" id="sidebarUserProfileLink" title="View Profile">
          <div class="sidebar-user-avatar">
            <%= (user.fullName ? user.fullName[0] : (user.username ? user.username[0] : 'U')).toUpperCase() %>
          </div>
          <div class="sidebar-user-details">
            <span class="sidebar-user-name"><%= user.fullName ? user.fullName.split(' ')[0] : user.username %></span>
            <span class="sidebar-user-role <%= isAdmin ? 'role-text-admin' : '' %>">
              <%= isAdmin ? 'Administrator' : 'Authorised User' %>
            </span>
          </div>
        </a>
        <a href="/logout" class="sidebar-logout-btn" id="sidebarLogoutBtn" title="Log Out">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
            <polyline points="16 17 21 12 16 7"/>
            <line x1="21" y1="12" x2="9" y2="12"/>
          </svg>
        </a>
      </div>
    <% } else { %>
      <div style="display:flex;gap:0.5rem;">
        <a href="/login" class="btn btn-ghost btn-sm" style="flex:1;">Sign In</a>
        <a href="/signup" class="btn btn-primary btn-sm" style="flex:1;">Sign Up</a>
      </div>
    <% } %>
  </div>
</aside>

<!-- Universal Toast Container -->
<div class="toast-container" id="globalToastContainer">
  <div class="toast" id="globalToast">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="20 6 9 17 4 12"/>
    </svg>
    <span id="globalToastMessage">Copied to clipboard!</span>
  </div>
</div>

<script>
  function toggleSidebarDrawer() {
    const sidebar = document.getElementById('appSidebar');
    const backdrop = document.getElementById('mobileSidebarBackdrop');
    if (!sidebar || !backdrop) return;
    sidebar.classList.toggle('mobile-open');
    backdrop.classList.toggle('mobile-open');
  }

  function closeSidebarDrawer() {
    const sidebar = document.getElementById('appSidebar');
    const backdrop = document.getElementById('mobileSidebarBackdrop');
    if (sidebar) sidebar.classList.remove('mobile-open');
    if (backdrop) backdrop.classList.remove('mobile-open');
  }

  // Universal copy link function with instant toast feedback
  function copyLink(code, btn) {
    const url = window.location.origin + '/' + code;
    navigator.clipboard.writeText(url).then(function() {
      showGlobalToast('Link copied: ' + url);
      if (btn) {
        const origSvg = btn.innerHTML;
        btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>';
        setTimeout(function() {
          btn.innerHTML = origSvg;
        }, 1800);
      }
    }).catch(function() {
      showGlobalToast('Link: ' + url);
    });
  }

  function showGlobalToast(msg) {
    const toast = document.getElementById('globalToast');
    const toastMsg = document.getElementById('globalToastMessage');
    if (!toast) return;
    if (toastMsg && msg) toastMsg.textContent = msg;
    toast.classList.add('show');
    setTimeout(function() {
      toast.classList.remove('show');
    }, 2400);
  }
</script>

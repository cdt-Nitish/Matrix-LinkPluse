<!-- LinkPulse Sidebar Navigation (Role-Specific & Auth-Aware Aesthetic) -->
<% 
  const isAuth = typeof user !== 'undefined' && user !== null;
  const userRole = isAuth ? (user.role || user.userType || 'user').toLowerCase() : 'guest';
  const isAdmin = userRole === 'admin' || userRole === 'host';
  const isUser = userRole === 'user' || userRole === 'creator' || userRole === 'member';
%>

<aside class="app-sidebar" id="appSidebar">
  <!-- Brand -->
  <div class="sidebar-brand-section">
    <a href="/" class="sidebar-brand" id="sidebarBrandLink">
      <div class="sidebar-logo-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="13 2 13 9 20 9"/><path d="M20 9L13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/>
        </svg>
      </div>
      <span class="brand-name">LinkPulse</span>
      <span class="brand-tag">v2.6</span>
    </a>
  </div>

  <!-- Primary CTA Area -->
  <div class="sidebar-cta-wrap">
    <% if (isAuth) { %>
      <a href="/links/new" class="sidebar-create-btn" id="sidebarCreateLinkBtn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        <span>+ New Link</span>
      </a>
    <% } else { %>
      <a href="/signup" class="sidebar-create-btn btn-cta-guest" id="sidebarGuestCtaBtn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/>
        </svg>
        <span>Get Started Free</span>
      </a>
    <% } %>
  </div>

  <!-- Role-Aware Navigation -->
  <nav class="sidebar-nav">
    <% if (isAuth) { %>
      <!-- Authenticated User / Admin Menu -->
      <div class="sidebar-section-title">Workspace</div>

      <a href="/" class="sidebar-nav-item <%= typeof page !== 'undefined' && page === 'dashboard' ? 'active' : '' %>" id="navDashboardLink">
        <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
        </svg>
        <span class="nav-item-text">Dashboard</span>
      </a>

      <a href="/analytics" class="sidebar-nav-item <%= typeof page !== 'undefined' && page === 'analytics' ? 'active' : '' %>" id="navAnalyticsLink">
        <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>
        </svg>
        <span class="nav-item-text"><%= isAdmin ? 'Platform Analytics' : 'My Analytics' %></span>
      </a>

      <a href="/campaigns" class="sidebar-nav-item <%= typeof page !== 'undefined' && page === 'campaigns' ? 'active' : '' %>" id="navCampaignsLink">
        <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
        </svg>
        <span class="nav-item-text">Campaigns</span>
      </a>

      <% if (isAdmin) { %>
        <div class="sidebar-section-title" style="margin-top:0.75rem;">Administration</div>

        <a href="/admin" class="sidebar-nav-item <%= typeof page !== 'undefined' && page === 'admin' ? 'active' : '' %>" id="navAdminLink">
          <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          <span class="nav-item-text">Admin &amp; Security</span>
          <span class="nav-item-badge admin-chip">ADMIN</span>
        </a>
      <% } %>

    <% } else { %>
      <!-- Unauthenticated / Guest Visitor Menu -->
      <div class="sidebar-section-title">Explore</div>

      <a href="/" class="sidebar-nav-item <%= typeof page !== 'undefined' && (page === 'welcome' || page === 'dashboard') ? 'active' : '' %>" id="navWelcomeHomeLink">
        <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        <span class="nav-item-text">Welcome &amp; Overview</span>
      </a>

      <a href="/#services" class="sidebar-nav-item" id="navWelcomeServicesLink">
        <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="13 2 13 9 20 9"/><path d="M20 9L13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/>
        </svg>
        <span class="nav-item-text">Our Services</span>
      </a>

      <a href="/#roles" class="sidebar-nav-item" id="navWelcomeRolesLink">
        <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        <span class="nav-item-text">Roles &amp; Access</span>
      </a>

      <a href="/#how-it-works" class="sidebar-nav-item" id="navWelcomeHowLink">
        <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 14 14"/>
        </svg>
        <span class="nav-item-text">How It Works</span>
      </a>

      <div class="sidebar-guest-notice-box">
        <div class="notice-title">Guest Visitor</div>
        <p class="notice-text">Log in or create an account to start shortening and sharing links.</p>
      </div>
    <% } %>
  </nav>

  <!-- Bottom Auth Section (ONLY Login / Signup for Guests; NO Logout for Guests) -->
  <div class="sidebar-auth-section">
    <% if (isAuth) { %>
      <div class="sidebar-user-card">
        <a href="/profile" class="sidebar-user-info" id="sidebarUserProfileLink" title="View Profile">
          <div class="sidebar-user-avatar">
            <%= (user.fullName ? user.fullName[0] : (user.username ? user.username[0] : 'U')).toUpperCase() %>
          </div>
          <div class="sidebar-user-details">
            <span class="sidebar-user-name"><%= user.fullName ? user.fullName.split(' ')[0] : user.username %></span>
            <span class="sidebar-user-role <%= isAdmin ? 'role-text-admin' : 'role-text-user' %>">
              <%= isAdmin ? 'Administrator' : 'Authorised User' %>
            </span>
          </div>
        </a>
        <a href="/logout" class="sidebar-logout-btn" id="sidebarLogoutBtn" title="Log Out">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
          </svg>
        </a>
      </div>
    <% } else { %>
      <!-- Unauthenticated: STRICTLY Login and Sign Up. NEVER Logout. -->
      <div class="sidebar-guest-card">
        <div class="sidebar-guest-actions">
          <a href="/login" class="sidebar-btn-login <%= typeof page !== 'undefined' && page === 'login' ? 'active' : '' %>" id="sidebarLoginBtn">
            Sign In
          </a>
          <a href="/signup" class="sidebar-btn-signup <%= typeof page !== 'undefined' && page === 'signup' ? 'active' : '' %>" id="sidebarSignupBtn">
            Sign Up
          </a>
        </div>
      </div>
    <% } %>
  </div>
</aside>

<!-- Mobile Navigation Bar -->
<div class="mobile-topbar" id="mobileTopbar">
  <a href="/" class="mobile-brand">
    <div class="sidebar-logo-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="13 2 13 9 20 9"/><path d="M20 9L13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/>
      </svg>
    </div>
    <span>LinkPulse</span>
  </a>

  <div class="mobile-right-actions">
    <% if (isAuth) { %>
      <a href="/links/new" class="btn btn-sm btn-primary">+ Link</a>
    <% } else { %>
      <a href="/login" class="btn btn-sm btn-ghost">Sign In</a>
      <a href="/signup" class="btn btn-sm btn-primary">Sign Up</a>
    <% } %>
    <button type="button" class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle navigation menu" onclick="toggleSidebarDrawer()">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </div>
</div>

<div class="mobile-sidebar-backdrop" id="mobileSidebarBackdrop" onclick="closeSidebarDrawer()"></div>

<script>
  function toggleSidebarDrawer() {
    const sidebar = document.getElementById('appSidebar');
    const backdrop = document.getElementById('mobileSidebarBackdrop');
    if (!sidebar || !backdrop) return;
    sidebar.classList.toggle('mobile-open');
    backdrop.classList.toggle('mobile-open');
  }

  function closeSidebarDrawer() {
    const sidebar = document.getElementById('appSidebar');
    const backdrop = document.getElementById('mobileSidebarBackdrop');
    if (sidebar) sidebar.classList.remove('mobile-open');
    if (backdrop) backdrop.classList.remove('mobile-open');
  }
</script>

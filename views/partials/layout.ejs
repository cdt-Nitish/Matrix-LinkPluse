<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> — LinkPulse</title>
  <meta name="description" content="<%= typeof desc !== 'undefined' ? desc : 'LinkPulse: URL Governance & Analytics Engine.' %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
  <%- include('theme-head') %>
  <%- typeof extraHead !== 'undefined' ? extraHead : '' %>
</head>
<body class="<%= typeof user !== 'undefined' && user ? 'app-layout' : 'landing-page' %>">
  <% if (typeof user !== 'undefined' && user) { %>
    <%- include('nav', { page: typeof page !== 'undefined' ? page : 'dashboard' }) %>
  <% } else { %>
    <header class="landing-nav-container">
      <div class="container">
        <nav class="landing-navbar">
          <a href="/" class="landing-brand">
            <div class="brand-logo-box" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="13 2 13 9 20 9"/>
                <path d="M20 9L13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/>
              </svg>
            </div>
            <span class="brand-logo-text">LinkPulse</span>
          </a>
          <div class="landing-nav-right">
            <a href="/login" class="landing-nav-link">Sign In</a>
            <a href="/signup" class="btn btn-primary btn-sm">Get Started</a>
            <button type="button" class="theme-toggle-btn" data-theme-toggle aria-label="Toggle theme" title="Toggle theme">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="theme-icon-sun" aria-hidden="true">
                <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
              </svg>
            </button>
          </div>
        </nav>
      </div>
    </header>
  <% } %>

  <main class="main-content">
    <div class="container">
      <%- body %>
    </div>
  </main>

  <%- include('footer') %>
</body>
</html>

<!-- LinkPulse Dedicated Top Header for Auth & Public Pages -->
<header class="auth-header">
  <div class="auth-header-inner">
    <a href="/" class="auth-header-brand" aria-label="LinkPulse Homepage">
      <div class="brand-logo-box" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="13 2 13 9 20 9"/>
          <path d="M20 9L13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/>
        </svg>
      </div>
      <span class="brand-logo-text">LinkPulse</span>
    </a>

    <div class="auth-header-actions">
      <!-- Theme Switcher Toggle (40px x 40px) -->
      <button 
        type="button" 
        class="theme-toggle-btn" 
        data-theme-toggle 
        id="themeToggleBtn"
        aria-label="Switch to light mode" 
        title="Switch to light mode"
      >
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="theme-icon-sun" aria-hidden="true">
          <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
      </button>

      <!-- Back to Home Button (40px high) -->
      <a href="/" class="btn-back-home" id="backToHomeBtn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="19" y1="12" x2="5" y2="12"/>
          <polyline points="12 19 5 12 12 5"/>
        </svg>
        <span class="back-home-text">Back to Home</span>
      </a>
    </div>
  </div>
</header>

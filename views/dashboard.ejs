<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Dashboard — LinkPulse</title>
  <meta name="description" content="Manage and track all your short links in one place.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>

<%- include('partials/nav', { page: 'dashboard' }) %>

<main class="main-content">
  <div class="container">

    <div class="page-header">
      <div>
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:4px;flex-wrap:wrap;">
          <h1 class="page-title"><%= typeof isAdmin !== 'undefined' && isAdmin ? 'Platform Links' : 'My Short Links' %></h1>
          <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
            <span class="badge badge-admin">Admin Role &bull; Full Access</span>
          <% } else { %>
            <span class="badge badge-user">Authorised User &bull; Creator Access</span>
          <% } %>
        </div>
        <p class="page-sub">
          <%= typeof isAdmin !== 'undefined' && isAdmin ? 'Global oversight: route, monitor, and govern all network links.' : 'Create, shorten, generate QR codes, and share your links across channels.' %>
        </p>
      </div>
      <div style="display:flex;gap:8px;">
        <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
          <a href="/admin" class="btn btn-ghost">Admin Panel &rarr;</a>
        <% } %>
        <a href="/links/new" class="btn btn-primary" id="dashboardCreateLinkBtn">+ New Link</a>
      </div>
    </div>

    <% if (query && query.deleted) { %>
    <div class="alert alert-error">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
      <span>Link was deleted successfully.</span>
    </div>
    <% } %>

    <% if (query && query.created) { 
        const createdLink = links.find(l => l.shortCode === query.created);
    %>
    <div class="alert-created" id="createdAlert">
      <div class="alert-created-info">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
        <div>
          <span style="font-weight:600;color:var(--green)">Link created successfully</span>
          <div style="font-size:0.8rem;color:var(--text-2);margin-top:2px;display:flex;align-items:center;gap:6px;flex-wrap:wrap">
            <span>Short URL:</span>
            <code id="createdShortUrlText" style="background:#0D131F;border:1px solid var(--border);padding:1px 5px;border-radius:4px;font-weight:500">/<%= query.created %></code>
            <% if (createdLink && createdLink.originalUrl) { %>
              <span class="muted" style="font-size:0.75rem">&rarr; <%= createdLink.originalUrl %></span>
            <% } %>
          </div>
        </div>
      </div>
      <div class="alert-created-actions" style="display:flex;gap:6px;">
        <button type="button" class="btn btn-sm btn-ghost" onclick="copyLink('<%= query.created %>', this)">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="margin-right:4px"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          Copy Link
        </button>
        <button type="button" class="btn btn-sm btn-primary" onclick="openShareModal('<%= query.created %>', '<%= createdLink ? encodeURIComponent(createdLink.title) : '' %>', '<%= createdLink ? encodeURIComponent(createdLink.originalUrl) : '' %>')">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="margin-right:4px"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
          Share &amp; QR
        </button>
      </div>
    </div>
    <script>
      (function(){
        var code = '<%= query.created %>';
        var el = document.getElementById('createdShortUrlText');
        if (el && code) {
          el.textContent = window.location.origin + '/' + code;
        }
      })();
    </script>
    <% } %>

    <!-- Flat Statistic Cards -->
    <div class="stats-row">
      <div class="stat-card">
        <div class="stat-value"><%= links.length %></div>
        <div class="stat-label"><%= typeof isAdmin !== 'undefined' && isAdmin ? 'Platform links' : 'My links' %></div>
      </div>
      <div class="stat-card">
        <div class="stat-value"><%= links.filter(l => l.status === 'active').length %></div>
        <div class="stat-label">Active links</div>
      </div>
      <div class="stat-card">
        <div class="stat-value"><%= links.reduce((s,l) => s + (l.currentClicks || 0), 0).toLocaleString() %></div>
        <div class="stat-label"><%= typeof isAdmin !== 'undefined' && isAdmin ? 'Total network clicks' : 'My link clicks' %></div>
      </div>
      <div class="stat-card">
        <div class="stat-value"><%= campaigns.length %></div>
        <div class="stat-label">Campaigns</div>
      </div>
    </div>

    <!-- Main Links Table -->
    <div class="section">
      <div class="section-header">
        <h2 class="section-title"><%= typeof isAdmin !== 'undefined' && isAdmin ? 'All Network Links' : 'My Active Links' %></h2>
        <input
          type="text"
          id="linkSearch"
          class="input"
          style="width:220px;padding:0.35rem 0.65rem;font-size:0.8rem;"
          placeholder="Search links…"
          oninput="filterLinks(this.value)"
        >
      </div>

      <% if (links.length === 0) { %>
        <div class="card empty-links-card">
          <div class="empty-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="13 2 13 9 20 9"/><path d="M20 9L13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/>
            </svg>
          </div>
          <h3 style="font-size:1.15rem;font-weight:600;color:var(--text-1);margin-bottom:0.4rem;">No Short Links Yet</h3>
          <p class="muted" style="max-width:440px;margin:0 auto 1.25rem;">
            You have full creation rights. Generate custom branded slugs, download vector QR codes, and share them across your channels.
          </p>
          <a href="/links/new" class="btn btn-primary">+ Create Your First Link</a>
        </div>
      <% } else { %>
      <div class="table-wrap">
        <table class="table" id="linksTable">
          <thead>
            <tr>
              <th style="width:160px;">Short URL</th>
              <th>Destination</th>
              <th>Campaign</th>
              <th style="text-align:right;width:100px;">Clicks</th>
              <th style="width:90px;">Status</th>
              <th style="width:110px;">Expires</th>
              <th style="text-align:right;width:140px;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% links.forEach(link => {
              const campaign = campaigns.find(c => c.id === link.campaignId);
            %>
            <tr data-q="<%= (link.title + link.shortCode + link.originalUrl).toLowerCase() %>">
              <td>
                <a href="/<%= link.shortCode %>" target="_blank" class="code-link">/<%= link.shortCode %></a>
              </td>
              <td>
                <div class="link-title"><%= link.title %></div>
                <div class="link-dest"><%= link.originalUrl %></div>
              </td>
              <td>
                <% if (campaign) { %>
                  <span class="tag"><%= campaign.name %></span>
                <% } else { %>
                  <span class="muted">—</span>
                <% } %>
              </td>
              <td style="text-align:right">
                <span style="font-weight:600;"><%= link.currentClicks.toLocaleString() %></span><% if (link.maxClicks) { %><span class="muted" style="font-size:0.75rem"> / <%= link.maxClicks %></span><% } %>
              </td>
              <td>
                <span class="badge badge-<%= link.status %>"><%= link.status %></span>
              </td>
              <td style="font-size:0.8rem;color:var(--text-2);">
                <% if (link.expiresAt) { %>
                  <%= new Date(link.expiresAt).toLocaleDateString('en-GB', {day:'2-digit',month:'short',year:'numeric'}) %>
                <% } else { %>
                  <span class="muted">Never</span>
                <% } %>
              </td>
              <td style="text-align:right">
                <div class="actions-cell">
                  <button type="button" class="btn-action" title="Copy Short Link" onclick="copyLink('<%= link.shortCode %>', this)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                  </button>
                  <button type="button" class="btn-action" title="Share Link &amp; QR" onclick="openShareModal('<%= link.shortCode %>', '<%= encodeURIComponent(link.title || '') %>', '<%= encodeURIComponent(link.originalUrl || '') %>')">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
                  </button>
                  <form method="POST" action="/links/<%= link.shortCode %>/toggle" style="margin:0;display:inline-flex">
                    <button type="submit" class="btn-action" title="<%= link.status === 'active' ? 'Disable link' : 'Enable link' %>">
                      <% if (link.status === 'active') { %>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
                      <% } else { %>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                      <% } %>
                    </button>
                  </form>
                  <form method="POST" action="/links/<%= link.shortCode %>/delete" onsubmit="return confirm('Permanently delete link /<%= link.shortCode %>?')" style="margin:0;display:inline-flex">
                    <button type="submit" class="btn-action" title="Delete link" style="color:var(--red)">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>

  </div>
</main>

<%- include('partials/share-modal') %>
<%- include('partials/footer') %>

<script>
function filterLinks(q) {
  document.querySelectorAll('#linksTable tbody tr').forEach(r => {
    r.style.display = r.dataset.q.includes(q.toLowerCase()) ? '' : 'none';
  });
}
</script>
</body>
</html>

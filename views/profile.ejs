<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %> — LinkPulse</title>
  <meta name="description" content="View and manage your LinkPulse workspace profile.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
  <%- include('partials/theme-head') %>
</head>
<body class="app-layout">

<%- include('partials/nav', { page: 'profile' }) %>

<main class="main-content">
  <!-- Authenticated Topbar -->
  <div class="app-topbar">
    <div class="topbar-left">
      <button type="button" class="topbar-drawer-btn" aria-label="Toggle navigation drawer" onclick="toggleSidebarDrawer()">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <span class="topbar-page-label">Account Profile</span>
    </div>
    <div class="topbar-right">
      <button type="button" class="theme-toggle-btn" data-theme-toggle aria-label="Toggle theme" title="Toggle theme" style="width:36px;height:36px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="theme-icon-sun" aria-hidden="true">
          <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
      </button>
      <a href="/logout" class="btn btn-ghost btn-sm" style="color:var(--error);">Sign Out</a>
    </div>
  </div>

  <div class="container container-sm">

    <div class="page-header">
      <div>
        <h1 class="page-title">Profile</h1>
        <p class="page-sub">Account credentials, role permissions, and organization details.</p>
      </div>
      <a href="/logout" class="btn btn-ghost" style="color:var(--error);">
        Sign Out
      </a>
    </div>

    <div class="card profile-box">
      <div class="profile-header-banner">
        <div class="profile-avatar-circle">
          <%= (profileUser.fullName ? profileUser.fullName[0] : (profileUser.username ? profileUser.username[0] : 'U')).toUpperCase() %>
        </div>
        <div>
          <h2 class="profile-name"><%= profileUser.fullName %></h2>
          <div class="profile-badge-row">
            <% const pRole = (profileUser.role || profileUser.userType || 'user').toLowerCase(); %>
            <span class="badge <%= (pRole === 'admin' || pRole === 'host') ? 'badge-admin' : 'badge-user' %>">
              <%= (pRole === 'admin' || pRole === 'host') ? 'Administrator' : 'Authorised User' %>
            </span>
            <span class="tag"><%= profileUser.accountType || (pRole === 'admin' ? 'Enterprise' : 'Pro') %></span>
          </div>
        </div>
      </div>

      <div class="profile-details-grid">
        <div class="detail-block">
          <span class="detail-label">Email Address</span>
          <span class="detail-value"><%= profileUser.email %></span>
        </div>

        <div class="detail-block">
          <span class="detail-label">Username</span>
          <span class="detail-value">@<%= profileUser.username %></span>
        </div>

        <div class="detail-block">
          <span class="detail-label">Organization</span>
          <span class="detail-value"><%= profileUser.organization || 'Independent' %></span>
        </div>

        <div class="detail-block">
          <span class="detail-label">Member Since</span>
          <span class="detail-value">
            <%= new Date(profileUser.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
          </span>
        </div>

        <div class="detail-block">
          <span class="detail-label">User ID</span>
          <code class="detail-code"><%= profileUser.id %></code>
        </div>

        <div class="detail-block">
          <span class="detail-label">Session Status</span>
          <span style="font-size:0.85rem;color:var(--success);font-weight:600;">Active</span>
        </div>
      </div>

      <div class="card-footer-actions">
        <a href="/" class="btn btn-ghost">&larr; Back to Dashboard</a>
        <a href="/links/new" class="btn btn-primary">+ Create New Link</a>
      </div>
    </div>

  </div>
</main>

<%- include('partials/footer') %>

</body>
</html>
